-static inline void arch_get_mem_node_and_type(unsigned long pfn, int *nid, eic770x_memory_type_t *p_mem_type)
+static inline void arch_get_mem_node_and_type(unsigned long pfn,
+	EIC770X_LOGICAL_MEM_NODE_E *nid, eic770x_memory_type_t *p_mem_type)
 {
 #ifdef CONFIG_NUMA
 	if (unlikely(PFN_IN_SPRAM_DIE0(pfn))) {
-		*nid = 0;
+		*nid = EIC770X_LOGICAL_SPRAM_NODE_0;
 		*p_mem_type = SPRAM;
 	}
 	else if(unlikely(PFN_IN_SPRAM_DIE1(pfn))) {
-		*nid = 1;
+		*nid = EIC770X_LOGICAL_SPRAM_NODE_1;
