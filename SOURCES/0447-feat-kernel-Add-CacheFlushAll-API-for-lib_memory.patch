 	else {
-		*nid = pfn_to_nid(pfn);
-		if (CHECK_MEMORY_RANGE_OPFUNC(pfn, MEM, INTPART0) || CHECK_MEMORY_RANGE_OPFUNC(pfn, MEM, INTPART1))
+		if (CHECK_MEMORY_RANGE_OPFUNC(pfn, MEM, INTPART0) ||
+			CHECK_MEMORY_RANGE_OPFUNC(pfn, MEM, INTPART1)) {
