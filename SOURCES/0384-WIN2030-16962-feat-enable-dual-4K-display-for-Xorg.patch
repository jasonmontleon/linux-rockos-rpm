From: zhangyizhong <zhangyizhong@eswincomputing.com>
Date: Fri, 10 Jan 2025 09:41:27 +0800
Subject: [PATCH 384/416] WIN2030-16962:feat:enable dual 4K display for Xorg.

Changelogs:
    enable dual 4K extended display for Xorg.

Change-Id: Ib9751189db6e6ede2657f7d2950ecd0a1cf61321
Signed-off-by: zhangyizhong <zhangyizhong@eswincomputing.com>
---
 drivers/gpu/drm/eswin/es_dc_hw.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/eswin/es_dc_hw.c b/drivers/gpu/drm/eswin/es_dc_hw.c
index 28b2a7b8f93f..4ba66b5bba2e 100644
--- a/drivers/gpu/drm/eswin/es_dc_hw.c
+++ b/drivers/gpu/drm/eswin/es_dc_hw.c
@@ -523,7 +523,7 @@ static const struct es_plane_info dc_hw_planes[][PLANE_NUM] = {
 			.modifiers = format_modifiers,
 			.min_width = 0,
 			.min_height = 0,
-			.max_width = 4096,
+			.max_width = 4096 * 2, //support dual 4K extended mode
 			.max_height = 4096,
 			.rotation = DRM_MODE_ROTATE_0 | DRM_MODE_ROTATE_180,
 			.color_encoding = BIT(DRM_COLOR_YCBCR_BT601) |
