From e32ee963dccff52ec2cbf21c620ca0dde81505b0 Mon Sep 17 00:00:00 2001
From: congyuyang <congyuyang@eswincomputing.com>
Date: Fri, 27 Dec 2024 16:59:27 +0800
Subject: [PATCH 483/652] feat:add memcp offset overflow check

Changelogs:
1. add memcp offset overflow check

Signed-off-by: congyuyang <congyuyang@eswincomputing.com>
---
 .../memory/eswin/es_dma_memcp/es_dma_memcp.c  | 20 +++++++++++++++++++
 include/uapi/linux/dma_memcp.h                |  4 ++--
 2 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/drivers/memory/eswin/es_dma_memcp/es_dma_memcp.c b/drivers/memory/eswin/es_dma_memcp/es_dma_memcp.c
index ba07f2bd38b5..1c2096270595 100644
--- a/drivers/memory/eswin/es_dma_memcp/es_dma_memcp.c
+++ b/drivers/memory/eswin/es_dma_memcp/es_dma_memcp.c
@@ -414,6 +414,26 @@ static int esw_cmdq_add_task(struct file *filp, void __user *user_arg) {
         return -EFAULT;
     }
 
+    if (memcp_f2f_cmd.len == 0) {
+        pr_err("Copy length is zero\n");
+        kfree(cmdq_task);
+        return -EINVAL;
+    }
+
+    if ((size_t)memcp_f2f_cmd.src_offset > SIZE_MAX - memcp_f2f_cmd.len) {
+        pr_err("Overflow detected in (src_offset + len), src_offset=%d, len=%zu\n",
+               memcp_f2f_cmd.src_offset, memcp_f2f_cmd.len);
+        kfree(cmdq_task);
+        return -EINVAL;
+    }
+
+    if ((size_t)memcp_f2f_cmd.dst_offset > SIZE_MAX - memcp_f2f_cmd.len) {
+        pr_err("Overflow detected in (dst_offset + len), dst_offset=%d, len=%zu\n",
+               memcp_f2f_cmd.dst_offset, memcp_f2f_cmd.len);
+        kfree(cmdq_task);
+        return -EINVAL;
+    }
+
     cmdq_task->cmdq = q;
     cmdq_task->f2f_cmd = memcp_f2f_cmd;
 
diff --git a/include/uapi/linux/dma_memcp.h b/include/uapi/linux/dma_memcp.h
index 7d0ffdca4d99..30ca7423a39c 100644
--- a/include/uapi/linux/dma_memcp.h
+++ b/include/uapi/linux/dma_memcp.h
@@ -36,9 +36,9 @@
  */
 struct esw_memcp_f2f_cmd {
     int src_fd;
-    int src_offset;
+    unsigned int src_offset;
     int dst_fd;
-    int dst_offset;
+    unsigned int dst_offset;
     size_t len;
     int timeout;
 };
-- 
2.54.0

