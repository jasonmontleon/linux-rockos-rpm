+static int es_sof_resume(struct snd_sof_dev *sdev)
+{
+	struct es_sof_priv *priv = (struct es_sof_priv *)sdev->pdata->hw_pdata;
+
+	es_dsp_request_channel(priv->dsp_ipc);
+	return 0;
