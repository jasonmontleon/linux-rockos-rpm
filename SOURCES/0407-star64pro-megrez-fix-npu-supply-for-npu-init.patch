From 17b77a6d9d0cc44d7f1f9cfb0a32a471b25fad21 Mon Sep 17 00:00:00 2001
From: Han Gao <rabenda.cn@gmail.com>
Date: Sun, 23 Feb 2025 01:51:50 +0800
Subject: [PATCH 407/654] star64pro & megrez: fix npu-supply for npu init

from: WIN2030-17055:feat: npu set voltage modify

Signed-off-by: Han Gao <rabenda.cn@gmail.com>
Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 arch/riscv/boot/dts/eswin/eic7700-milkv-megrez.dts     | 6 +++++-
 arch/riscv/boot/dts/eswin/eic7700-pine64-starpro64.dts | 3 +++
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7700-milkv-megrez.dts b/arch/riscv/boot/dts/eswin/eic7700-milkv-megrez.dts
index e2b84bec70e0..44909d48079b 100644
--- a/arch/riscv/boot/dts/eswin/eic7700-milkv-megrez.dts
+++ b/arch/riscv/boot/dts/eswin/eic7700-milkv-megrez.dts
@@ -275,6 +275,8 @@ &pcie {
 
 &d0_npu{
 	status = "okay";
+	npu-supply=<&npu_vcc1>;
+	apply_npu_1G_freq;
 };
 
 &d0_dsp_subsys {
@@ -745,7 +747,7 @@ es5430@f {
 		eswin,regulator_label = "supply vdd1", "npu vdd1", "npu current1", "npu temperature1";
 		label = "npu_vdd";
 		regulators{
-			d0_npu_vcc:npu_svcc{
+			npu_vcc1:npu_svcc{
 				regulator-name="NPU_SVCC";
 				regulator-min-microvolt=<700000>;
 				regulator-max-microvolt=<1100000>;
@@ -947,6 +949,8 @@ &gpio0 {
 	status = "okay";
 };
 &dev_llc_d0{
+	/* apply_npu_1G_freq; */
+	npu-supply=<&npu_vcc1>;
 	apply_npu_high_freq;
 };
 
diff --git a/arch/riscv/boot/dts/eswin/eic7700-pine64-starpro64.dts b/arch/riscv/boot/dts/eswin/eic7700-pine64-starpro64.dts
index 70889ccceb7d..89ed4514b0bc 100644
--- a/arch/riscv/boot/dts/eswin/eic7700-pine64-starpro64.dts
+++ b/arch/riscv/boot/dts/eswin/eic7700-pine64-starpro64.dts
@@ -242,6 +242,7 @@ &pcie {
 
 &d0_npu{
 	status = "okay";
+	npu-supply=<&npu_vcc1>;
 };
 
 &d0_dsp_subsys {
@@ -847,6 +848,8 @@ &gpio0 {
 	status = "okay";
 };
 &dev_llc_d0{
+	/* apply_npu_1G_freq; */
+	npu-supply=<&npu_vcc1>;
 	apply_npu_high_freq;
 };
 
-- 
2.51.0

