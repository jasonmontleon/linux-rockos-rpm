From bd6f0e548af91564299ab4b7098a68a805e2b0b6 Mon Sep 17 00:00:00 2001
From: Xiang Xu <xuxiang@eswincomputing.com>
Date: Fri, 16 May 2025 13:28:57 +0800
Subject: [PATCH 509/652] feat: osm dts add gpio pinctrl script

Changelogs:
1. osm dts add gpio pinctrl script

Signed-off-by: Xiang Xu <xuxiang@eswincomputing.com>
---
 arch/riscv/boot/dts/eswin/eic7700-osm.dts | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7700-osm.dts b/arch/riscv/boot/dts/eswin/eic7700-osm.dts
index 420ff1e42117..ae1af65fcc40 100644
--- a/arch/riscv/boot/dts/eswin/eic7700-osm.dts
+++ b/arch/riscv/boot/dts/eswin/eic7700-osm.dts
@@ -870,8 +870,13 @@ &timer3 {
 
 &pinctrl {
 	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_gpio7_default &pinctrl_gpio8_default &pinctrl_gpio9_default &pinctrl_gpio10_default
+			&pinctrl_gpio71_default &pinctrl_gpio73_default &pinctrl_gpio74_default &pinctrl_gpio75_default 
+			&pinctrl_gpio76_default &pinctrl_gpio77_default &pinctrl_gpio79_default &pinctrl_gpio80_default 
+			&pinctrl_gpio83_default &pinctrl_gpio84_default &pinctrl_gpio85_default &pinctrl_gpio86_default
+			&pinctrl_gpio87_default &pinctrl_gpio89_default &pinctrl_gpio91_default &pinctrl_gpio92_default>;
 };
-
 &gpio0 {
 	status = "okay";
 };
