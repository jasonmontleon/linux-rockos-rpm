-	PVRSRV_ERROR err = PVRSRV_OK;
-	struct sync_fence *sync_fence = (struct sync_fence *)fence_data_to_rollback;
-	struct sync_pt *sync_pt;
-	struct pvr_sync_pt *pvr_pt = NULL;
-	int j = 0;
