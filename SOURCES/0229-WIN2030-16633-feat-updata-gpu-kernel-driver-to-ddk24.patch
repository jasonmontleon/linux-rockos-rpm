+				edata->load_count >>= timer_shift;	/*!< convert load to ticks */
+			}
+		}
+	}
+	else
 	{
+		/* timer runs continuously, effective load is 100% */
+		edata->total_count = edata->load_count;
+	}
+
+	return 0;
+}
