-			if (!RA_BASE_IS_INVALID(psPageArrayData->paBaseArray[pui32MapTable[i]]))
-			{
-				PVR_DPF((PVR_DBG_ERROR,
-						"%s: Mapping already exists Index %u Mapping index %u",
-						__func__,
-						i,
-						pui32MapTable[i]));
-				eMapCheckError = PVRSRV_ERROR_PMR_MAPPING_ALREADY_EXISTS;
