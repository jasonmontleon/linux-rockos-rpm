+								sCpuPAddr,
+								PAGE_SIZE,
+								OSGetCurrentClientProcessIDKM()
+								DEBUG_MEMSTATS_VALUES);
+#endif
+
+	return iFault;
+
+ErrSigFaultReturn:
+	iFault = VM_FAULT_SIGBUS;
+ErrReturn:
+	PMRUnlockPMR(psPMR);
+	return iFault;
