-#endif
-
-	eError = RA_AllocMultiSparse(psPageArrayData->psArena,
-	                              psPageArrayData->uiLog2ChunkSize,
-	                              RA_NO_IMPORT_MULTIPLIER,
-	                              0,
-	                              "LMA_Page_Alloc",
-	                              psPageArrayData->paBaseArray,
-	                              psPageArrayData->uiTotalNumChunks,
-	                              pui32MapTable,
-	                              uiChunksToAlloc);
-	if (PVRSRV_OK != eError)
-	{
-		RA_USAGE_STATS sRAStats;
