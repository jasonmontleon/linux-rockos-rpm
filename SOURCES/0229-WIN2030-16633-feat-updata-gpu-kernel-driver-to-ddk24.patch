-#if defined(PVRSRV_ENABLE_GPU_MEMORY_INFO)
-	{
-		/* Dummy handle - we don't need to store the reference to the PMR RI entry. Its deletion is handled internally. */
-		eError = RIWritePMREntryKM (psPMR);
