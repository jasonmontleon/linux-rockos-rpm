-IMG_UINT32 RGXReadModifyWriteReg64(const void *hPrivate,
-                                   IMG_UINT32 ui32RegAddr,
-                                   IMG_UINT64 uiRegValueNew,
-                                   IMG_UINT64 uiRegKeepMask)
-{
-	RGX_LAYER_PARAMS *psParams;
