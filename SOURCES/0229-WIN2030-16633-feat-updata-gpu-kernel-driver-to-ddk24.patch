-PVRSRV_ERROR DCDisplayContextConfigure(DC_DISPLAY_CONTEXT *psDisplayContext,
-                                       IMG_UINT32 ui32PipeCount,
-                                       PVRSRV_SURFACE_CONFIG_INFO *pasSurfAttrib,
-                                       DC_BUFFER **papsBuffers,
