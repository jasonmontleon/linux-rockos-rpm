-
-	PVR_ASSERT(INDEX_TO_BLOCK_FREE_HAND_COUNT(psBase, ui32ValidatedHandleIndex)<= HANDLE_BLOCK_SIZE);
-
-#if defined(DEBUG)
-	{
-		IMG_UINT32 ui32BlockedIndex;
-		IMG_UINT32 ui32TotalFreeHandCount = 0;
