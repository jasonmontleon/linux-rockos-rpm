-		}
-
-		PVR_ASSERT(ui32TotalFreeHandCount == psBase->ui32TotalFreeHandCount);
-	}
-#endif /* defined(DEBUG) */
-
-	if (ppvData)
-	{
-		*ppvData = pvData;
-	}
-
-	PVR_DPF((PVR_DBG_MESSAGE, "Handle release base %p hdl %p", psBase, hHandle));
-
-	return PVRSRV_OK;
-}
