-{
-	RGXRISCVFW_ABSTRACT_CMD_ERR eCmdErr;
-
-#if defined(NO_HARDWARE) && defined(PDUMP)
-	eCmdErr = RISCV_ABSTRACT_CMD_NO_ERROR;
-
-	/* Check error status */
-	PDUMPREGPOL(psDevInfo->psDeviceNode,
-	            RGX_PDUMPREG_NAME,
