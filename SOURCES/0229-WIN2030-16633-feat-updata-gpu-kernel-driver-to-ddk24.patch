-		eError = RGXSendCommandAndGetKCCBSlot(psDevInfo,
-		                                      &sPowCmd,
-		                                      PDUMP_FLAGS_NONE,
-		                                      &ui32CmdKCCBSlot);
-		if (eError != PVRSRV_OK)
