-#if defined(SUPPORT_LINUX_DVFS)
-				eError = SuspendDVFS(psDeviceNode);
-				if (eError != PVRSRV_OK)
-				{
-					PVR_DPF((PVR_DBG_ERROR, "%s: Failed to suspend DVFS", __func__));
-					return eError;
-				}
-#endif
-
-				psDevInfo->bRGXPowered = IMG_FALSE;
-
-				eError = RGXDoStop(psDeviceNode);
-				if (eError != PVRSRV_OK)
