-static PVRSRV_ERROR
-_FreeLMPageArray(PMR_LMALLOCARRAY_DATA *psPageArrayData)
-{
-
-	OSFreeMem(psPageArrayData->paBaseArray);
-
-	PVR_DPF((PVR_DBG_MESSAGE,
-			"physmem_lma.c: freed local memory array structure for PMR @0x%p",
