-		pvr_pt = (struct pvr_sync_pt *)sync_pt;
-
-		SyncCheckpointError(pvr_pt->sync_data->kernel->fence_sync->client_sync_checkpoint,
-				    PVRSRV_FENCE_FLAG_SUPPRESS_HWP_PKT);
