-		_DCDeviceBufferArrayDestroy(ahBuffers);
-	}
-
-	return PVRSRV_OK;
-
-FailCommandAlloc:
-FailMapBuffer:
-	if (ui32PipeCount != 0)
-	{
-		for (i=0;i<ui32BuffersMapped;i++)
-		{
-			_DCBufferUnmap(papsBuffers[i]);
-		}
-	}
-FailConfigCheck:
-	if (ui32PipeCount != 0)
-	{
-		_DCDeviceBufferArrayDestroy(ahBuffers);
-	}
-FailBufferArrayCreate:
-FailMaxDepth:
-	_DCDisplayContextReleaseRef(psDisplayContext);
-
-	return eError;
-}
