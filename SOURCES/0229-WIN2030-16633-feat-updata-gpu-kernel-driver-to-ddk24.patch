+	dllist_foreach_node(psDevAddrRegions, psThis, psNext)
+	{
+		DEVMEMINT_PDUMP_VALID_REGION *psRegion =
+		    IMG_CONTAINER_OF(psThis, DEVMEMINT_PDUMP_VALID_REGION, sNode);
