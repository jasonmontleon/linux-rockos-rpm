From 8ade9c1f369002d43e5ef60567f4828abfb6e7f6 Mon Sep 17 00:00:00 2001
From: Han Gao <gaohan@iscas.ac.cn>
Date: Sat, 2 Nov 2024 22:09:23 +0800
Subject: [PATCH 218/416] fix: dts: megrez audio: remove unused es8388

Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 .../boot/dts/eswin/eic7700-milkv-megrez.dts   | 27 +++----------------
 1 file changed, 4 insertions(+), 23 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7700-milkv-megrez.dts b/arch/riscv/boot/dts/eswin/eic7700-milkv-megrez.dts
index b060cebe874b..fbab3ae40f53 100644
--- a/arch/riscv/boot/dts/eswin/eic7700-milkv-megrez.dts
+++ b/arch/riscv/boot/dts/eswin/eic7700-milkv-megrez.dts
@@ -383,13 +383,7 @@ d0_i2s1_endpoint: endpoint {
 };
 
 &d0_i2s2 {
-	status = "okay";
-	d0_i2s2_port: port {
-		d0_i2s2_endpoint: endpoint {
-			remote-endpoint = <&d0_codec1_endpoint>;
-			dai-format = "i2s";
-		};
-	};
+	status = "disabled";
 };
 
 &d0_graphcard0 {
@@ -400,14 +394,12 @@ &d0_graphcard0 {
 
 &d0_graphcard1 {
 	status = "okay";
-	label = "Analog Audio-1";
-	dais = <&d0_i2s2_port>;
+	label = "HDMI Audio";
+	dais = <&d0_i2s0_port>;
 };
 
 &d0_graphcard2 {
-	status = "okay";
-	label = "HDMI Audio";
-	dais = <&d0_i2s0_port>;
+        status = "disabled";
 };
 
 &isp_0 {
@@ -675,17 +667,6 @@ d0_codec0_endpoint: endpoint {
 			};
 		};
 	};
-	d0_es8388_1: es8388-1@11 {
-		compatible = "eswin,es8388";
-		reg = <0x11>;
-		#sound-dai-cells = <0>;
-		port {
-			d0_codec1_endpoint: endpoint {
-				system-clock-frequency = <12288000>;
-				remote-endpoint = <&d0_i2s2_endpoint>;
-			};
-		};
-	};
 };
 
 &d0_i2c1 {
