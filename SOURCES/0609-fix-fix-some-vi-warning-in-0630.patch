From c33e5e88980298eead50ccb71596a91a5291827a Mon Sep 17 00:00:00 2001
From: congyuyang <congyuyang@eswincomputing.com>
Date: Tue, 1 Jul 2025 14:00:00 +0800
Subject: [PATCH 609/654] fix: fix some vi warning in 0630

Changelogs:
1. fix some vi warning in 0630

Signed-off-by: congyuyang <congyuyang@eswincomputing.com>
---
 arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi b/arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi
index b8d68edbe239..6a419ddbc324 100644
--- a/arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi
+++ b/arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi
@@ -2122,7 +2122,7 @@ d1_vi_subsys: d1-vi-subsys@71000000 {
 			ranges;
 			status = "okay";
 
-			d1_vi_top_csr: vi_common_top_csr@0x71030000 {
+			d1_vi_top_csr: vi_common_top_csr@71030000 {
 				compatible = "esw,vi-common-csr", "syscon";
 				clocks = <&d1_clock EIC7700_CLK_VI_ACLK>,
 						 <&d1_clock EIC7700_CLK_VI_CFG_CLK>,
@@ -2163,7 +2163,7 @@ d1_vi_top_csr: vi_common_top_csr@0x71030000 {
 				numa-node-id = <1>;
 			};
 
-			d1_isp_0: isp@0x71000000 {
+			d1_isp_0: isp@71000000 {
 				compatible = "esw,win2030-isp";
 				reg = <0x0 0x71000000 0x0 0x10000>;
 				interrupts = <21 19 20>;
@@ -2177,7 +2177,7 @@ d1_isp_0: isp@0x71000000 {
 				dma-noncoherent;
 			};
 
-			d1_isp_1: isp@0x71010000 {
+			d1_isp_1: isp@71010000 {
 				compatible = "esw,win2030-isp";
 				reg = <0x0 0x71010000 0x0 0x10000>;
 				interrupts = <24 22 23>;
@@ -2231,6 +2231,7 @@ d1_dvp2axi: d1-dvp2axi@71034000 {
 									"dvp2axi_error_int","dvp2axi_afull_int";
 				dma-noncoherent;
 				numa-node-id = <1>;
+				#size-cells = <2>;
 				dma-ranges = <0x0 0x20000000 0x0 0x80000000 0x0 0x40000000>;
 				iommus = <&smmu1 WIN2030_SID_DW>;
 				tbus = <WIN2030_TBUID_DW>;
@@ -2472,7 +2473,7 @@ d1_mipi_dphy_rx: dphy@710c0000 {
 				numa-node-id = <1>;
 			};
 
-			d1_csi_dma0: csidma@0x72048000 {
+			d1_csi_dma0: csidma@72048000 {
 				compatible = "eswin,csi-video";
 				interrupt-parent = <&plic1>;
 				interrupts = <29>;
@@ -2491,7 +2492,7 @@ d1_csi_dmar_0: endpoint@0 {
 				};
 			};
 
-			d1_csi_dma1: csidma@0x72058000 {
+			d1_csi_dma1: csidma@72058000 {
 				compatible = "eswin,csi-video";
 				interrupt-parent = <&plic1>;
 				interrupts = <30>;
-- 
2.51.0

