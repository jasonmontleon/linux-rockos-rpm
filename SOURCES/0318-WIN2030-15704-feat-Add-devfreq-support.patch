@@ -1269,7 +1275,6 @@ int es_dsp_hw_init(struct es_dsp *dsp)
 		hw->pts_iova = 0;
 		goto err;
 	}
-	es_dsp_set_rate(hw, dsp->rate);
 	dev_dbg(dsp->dev, "firmware-name:%s.\n", dsp->firmware_name);
 	return 0;
 err:
