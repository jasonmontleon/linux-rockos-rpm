 			dma-names = "rx", "tx";
-			dmas = <&d0_aon_dmac 4 0>, <&d0_aon_dmac 5 0>;
+			dmas = <&d0_aon_dmac 4 4 0>, <&d0_aon_dmac 5 5 0>;
 			vo_mclk_sel,syscrg = <&d0_sys_crg 0x1bc>;
