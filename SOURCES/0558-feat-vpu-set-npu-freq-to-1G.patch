From 5b28ba1c8946e328f870980e1e4067cf4e804985 Mon Sep 17 00:00:00 2001
From: donghuawei <donghuawei@eswincomputing.com>
Date: Fri, 13 Jun 2025 18:12:58 +0800
Subject: [PATCH 558/652] feat: vpu set npu freq to 1G

Changelogs:
	set npu freq 1G for vpu

Signed-off-by: donghuawei <donghuawei@eswincomputing.com>
---
 arch/riscv/boot/dts/eswin/vpu7702-pcie-a2.dts      | 1 +
 arch/riscv/boot/dts/eswin/vpu7702-pcie.dts         | 1 +
 arch/riscv/boot/dts/eswin/vpu7702_pcie_factory.dts | 1 +
 3 files changed, 3 insertions(+)

diff --git a/arch/riscv/boot/dts/eswin/vpu7702-pcie-a2.dts b/arch/riscv/boot/dts/eswin/vpu7702-pcie-a2.dts
index 9dba60840c6a..0dad82e8e581 100644
--- a/arch/riscv/boot/dts/eswin/vpu7702-pcie-a2.dts
+++ b/arch/riscv/boot/dts/eswin/vpu7702-pcie-a2.dts
@@ -376,6 +376,7 @@ &pcie {
 
 &d0_npu{
 	status = "disabled";
+	apply_npu_1G_freq;
 	npu-supply=<&npu_vcc1>;
 };
 
diff --git a/arch/riscv/boot/dts/eswin/vpu7702-pcie.dts b/arch/riscv/boot/dts/eswin/vpu7702-pcie.dts
index 372a533eaba3..81d0576394f3 100644
--- a/arch/riscv/boot/dts/eswin/vpu7702-pcie.dts
+++ b/arch/riscv/boot/dts/eswin/vpu7702-pcie.dts
@@ -376,6 +376,7 @@ &pcie {
 
 &d0_npu{
 	status = "disabled";
+	apply_npu_1G_freq;
 	npu-supply=<&npu_vcc1>;
 };
 
diff --git a/arch/riscv/boot/dts/eswin/vpu7702_pcie_factory.dts b/arch/riscv/boot/dts/eswin/vpu7702_pcie_factory.dts
index cf7b8dbc7680..2661819c021c 100644
--- a/arch/riscv/boot/dts/eswin/vpu7702_pcie_factory.dts
+++ b/arch/riscv/boot/dts/eswin/vpu7702_pcie_factory.dts
@@ -376,6 +376,7 @@ &pcie {
 
 &d0_npu{
 	status = "okay";
+	apply_npu_1G_freq;
 	npu-supply=<&npu_vcc1>;
 };
 
-- 
2.52.0

