From 54ef3bbe99cfb917d7d20cea36ec1355ae2a5769 Mon Sep 17 00:00:00 2001
From: yufangxian <yufangxian@eswincomputing.com>
Date: Fri, 30 May 2025 11:13:30 +0800
Subject: [PATCH 522/652] fix: fix sbc-camera dts warning log

Changelogs:
1. add size-cell in camera dts

Signed-off-by: yufangxian <yufangxian@eswincomputing.com>
---
 arch/riscv/boot/dts/eswin/eic7700-sbc-a1-camera.dtsi | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/riscv/boot/dts/eswin/eic7700-sbc-a1-camera.dtsi b/arch/riscv/boot/dts/eswin/eic7700-sbc-a1-camera.dtsi
index c34f0ce141905..f75d8d78518ce 100644
--- a/arch/riscv/boot/dts/eswin/eic7700-sbc-a1-camera.dtsi
+++ b/arch/riscv/boot/dts/eswin/eic7700-sbc-a1-camera.dtsi
@@ -54,6 +54,7 @@ vvcam_isp_port0_raw: endpoint {
 	vvcam_vb: vvcam-vb@0 {
 		compatible = "verisilicon,vb";
 		status = "okay";
+		#size-cells = <2>;
 		dma-noncoherent;
 		dma-ranges = <0x0 0x20000000 0x0 0x80000000 0x0 0x40000000>;
 		iommus = <&smmu0 WIN2030_SID_ISP0>;
@@ -63,6 +64,7 @@ vvcam_video_0: vvcam_video@0 {
 		compatible = "verisilicon,video";
 		id = <0>;
 		status = "okay";
+		#size-cells = <2>;
 		dma-noncoherent;
 		dma-ranges = <0x0 0x20000000 0x0 0x80000000 0x0 0x40000000>;
 		iommus = <&smmu0 WIN2030_SID_ISP0>;
-- 
2.51.1

