From cc4d210b7dedfc85178f4d92370819dc05b7d813 Mon Sep 17 00:00:00 2001
From: ningyu <ningyu@eswincomputing.com>
Date: Wed, 23 Apr 2025 14:40:47 +0800
Subject: [PATCH 485/652] fix:enable usb2.0 hub

Changelogs:
Set usb load switch to provide voltage

Signed-off-by: ningyu <ningyu@eswincomputing.com>
---
 arch/riscv/boot/dts/eswin/eic7702-d560.dts        | 13 ++++++++++---
 arch/riscv/boot/dts/eswin/eic7x-die1-pinctrl.dtsi |  5 +++++
 2 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-d560.dts b/arch/riscv/boot/dts/eswin/eic7702-d560.dts
index 33926ca407292..bee85411e33ad 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-d560.dts
+++ b/arch/riscv/boot/dts/eswin/eic7702-d560.dts
@@ -88,6 +88,13 @@ aw315:wifi_aw3155@0 {
 	};
 };
 
+&d0_usbdrd3_1 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_die0_gpio14_default>;
+	hub-rst-gpios = <&porta 14 GPIO_ACTIVE_HIGH>;
+};
+
 &d1_uart1 {
 	/* BT M.2 KEY-E */
 	status = "okay";
@@ -198,11 +205,11 @@ fusb303b@21 {
 		compatible = "fcs,fusb303b";
 		status = "okay";
 		reg = <0x21>;
-		eswin,syscfg = <&d0_sys_con 0x3C0 12>;
+		eswin,syscfg = <&d1_sys_con 0x3C0 12>;
 
 		pinctrl-names = "default";
-		pinctrl-0 = <&pinctrl_die0_gpio30_default>;
-		int-gpios = <&porta 30 GPIO_ACTIVE_HIGH>;
+		pinctrl-0 = <&pinctrl_die1_gpio30_default>;
+		int-gpios = <&d1_porta 30 GPIO_ACTIVE_HIGH>;
 		connector {
 			compatible = "usb-c-connector";
 			label = "USB-C";
diff --git a/arch/riscv/boot/dts/eswin/eic7x-die1-pinctrl.dtsi b/arch/riscv/boot/dts/eswin/eic7x-die1-pinctrl.dtsi
index fcb3d855c105d..88b7a0e850b0a 100644
--- a/arch/riscv/boot/dts/eswin/eic7x-die1-pinctrl.dtsi
+++ b/arch/riscv/boot/dts/eswin/eic7x-die1-pinctrl.dtsi
@@ -822,6 +822,11 @@ mux {
 					groups = "gpio30_group";
 					function = "gpio30_func";
 				};
+				conf {
+					groups = "gpio30_group";
+					input-enable = <1>;
+					bias-pull-down = <1>;
+				};
 			};
             pinctrl_die1_gpio31_default: gpio31-default{
 				mux {
-- 
2.53.0

