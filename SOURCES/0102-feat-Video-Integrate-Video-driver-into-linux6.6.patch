+static gceSTATUS
+_ProgramTPKernel(gckHARDWARE Hardware, gctUINT8 DataType,
+                 gctUINT32 KernelXSize, gctUINT32 KernelYSize, gctUINT32 KernelZSize,
+                 chipCmdData *cd, gctUINT32 AllocFlag,
