+    p->sRAMRequested = sRAMRequested;
+    p->sRAMLoopMode  = sRAMLoopMode;
+
+    p->baseAddress = baseAddress;
+    p->physSize    = physSize;
+    p->bankSize    = bankSize; /* not a module param. */
+
+    p->recovery = recovery;
