+    gcmkONERROR(gckOS_WriteRegisterEx(Hardware->os, Hardware->kernel,
+                                      0x00014, 0xFFFFFFFF));
+
+    if (gckHARDWARE_IsFeatureAvailable(Hardware, gcvFEATURE_BLT_ENGINE)) {
