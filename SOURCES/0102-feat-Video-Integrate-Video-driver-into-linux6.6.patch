+static gceSTATUS
+_ReleaseVideoMemoryHandle(gckKERNEL Kernel, gcsEVENT_PTR Record, gcsHAL_INTERFACE *Interface)
+{
+    gceSTATUS status;
+    gckVIDMEM_NODE nodeObject;
+    gctUINT32 handle;
