+                gcmkASSERT(0);
+        }
+
+#if gcdDUMP_IN_KERNEL
+        gcmkDUMP(Mmu->os, "#[mmu-stlb: flat-mapping: 0x%08X - 0x%08X]",
+                 start, start + (last - sStart) * gcdMMU_PAGE_64K_SIZE - 1);
+#endif
