+static gctBOOL
+_IsHWIdle(gctUINT32 Idle, gckHARDWARE Hardware)
+{
+#if !gcdFPGA_BUILD
+    Idle |= 1 << 14;
+#endif
+
+    return Idle == 0x7FFFFFFF;
+}
