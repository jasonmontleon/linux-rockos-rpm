+    /* Make sure FE is idle. */
+    do {
+        gcmkVERIFY_OK(gckOS_ReadRegisterEx(Hardware->os, Hardware->kernel,
+                                           0x00004, &idle));
+    } while (idle != 0x7FFFFFFF);
+
+    gcmkVERIFY_OK(gckOS_ReadRegisterEx(Hardware->os, Hardware->kernel,
+                                       0x00664,
+                                       &resume));
+
+    gcmkVERIFY_OK(gckOS_ReadRegisterEx(Hardware->os, Hardware->kernel,
+                                       0x00664,
+                                       &resume));
+
+    gcmkVERIFY_OK(gckWLFE_WaitLink(Hardware, gcvNULL, gcvINVALID_ADDRESS,
+                                   resume & (pageSize - 1),
+                                   &bytes, gcvNULL, gcvNULL));
