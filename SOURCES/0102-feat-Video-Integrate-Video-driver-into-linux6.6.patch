+#if gcdENDIAN_BIG
+
+# define _WritePageEntry(pageEntry, entryValue) \
+        (*(gctUINT32_PTR)(pageEntry) = gcmBSWAP32((gctUINT32)(entryValue)))
+
+# define _ReadPageEntry(pageEntry) \
