+     **
+     */
+    gceSTATUS
+    (*switchCoreCount)(gcsPLATFORM *Platform, gctUINT32 *Count);
+#endif
+} gcsPLATFORM_OPERATIONS;
+
+struct _gcsPLATFORM {
