+    while (mStart <= mEnd) {
+        gctUINT32 last = (mStart == mEnd) ? sEnd : (gcdMMU_STLB_64K_ENTRY_NUM - 1);
+        gctPHYS_ADDR_T stlbPhyBase;
+        gctUINT32_PTR stlbLogical;
