+int gc_recovery_trigger_debugfs(struct seq_file *m, void *data){
+    gckGALDEVICE device = galDevice;
+    gckKERNEL kernel = _GetValidKernel(device);
+    gceSTATUS status = gcvSTATUS_OK;
+    gctUINT stuckDump = kernel->stuckDump;
+    gctINT32 i;
+
+    for (i = gcvCORE_2D; i <= gcvCORE_2D1; i++) {
+        gckKERNEL ker = gcvNULL;
+        gckOS_QueryKernel(kernel, i, &ker);
+        if(ker){
+            ker->recovery = gcvTRUE;
+            ker->stuckDump = gcvSTUCK_DUMP_NONE;
+            status = gckKERNEL_Recovery(ker);
+            ker->stuckDump = stuckDump;
+            ker->recovery = gcvFALSE;
+        }
+    }
+    return status;
+}
