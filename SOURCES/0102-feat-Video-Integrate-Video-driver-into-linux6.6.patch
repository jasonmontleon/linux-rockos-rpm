+    Interface->u.ImportVideoMemory.handle = handle;
+    return gcvSTATUS_OK;
+
+OnError:
+    if (handle)
+        gckVIDMEM_HANDLE_Dereference(Kernel, ProcessID, handle);
+
+    if (nodeObject)
+        gckVIDMEM_NODE_Dereference(Kernel, nodeObject);
+
+    return status;
+}
