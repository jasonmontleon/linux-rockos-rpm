+ *       the performance.  However, heaps won't be freed until they are
+ *       completely free, so there might be some more memory waste if the size is
+ *       too big.
+ */
+#ifndef gcdHEAP_SIZE
+#define gcdHEAP_SIZE (64 << 10)
+#endif
