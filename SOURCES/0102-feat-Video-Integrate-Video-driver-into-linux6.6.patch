+#define HANTRO_AFBC_OFFSET 0x20
+
+void AFBCBypass(volatile unsigned char *hwregs)
+{
+	if (!hwregs)
+		return;
+
+	/* AFBC pass through */
+	iowrite32(0x2, (void __iomem *)(hwregs + HANTRO_AFBC_OFFSET));
+	pr_info("AFBC Bypass: 0x20 = 0x%x\n",
