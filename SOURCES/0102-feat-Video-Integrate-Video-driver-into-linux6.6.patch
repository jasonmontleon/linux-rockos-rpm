+        golden[126] = 0x8e;
+        golden[127] = 0x31;
+    } else if (Hardware->identity.customerID == 0x96) {
+        golden[0]  = 0x32;
+        golden[1]  = 0x0;
+        golden[2]  = 0xfe;
+        golden[3]  = 0xfa;
+        golden[4]  = 0x16;
+        golden[5]  = 0xfe;
