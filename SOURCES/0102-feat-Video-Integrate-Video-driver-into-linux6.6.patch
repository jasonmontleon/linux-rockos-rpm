+	if (dev->fe.enable) {
+		dw200_fe_read_reg(dev, DEWARP_REGISTER_BASE_ADDR + offset,
+				  &val);
+	} else {
+		val = __raw_readl(dev->dwe_base + offset);
+	}
+	// pr_info("dwe read addr 0x%08x val 0x%08x\n",DEWARP_REGISTER_BASE_ADDR+offset,val);
+	return val;
