+#define gcmCLAMP(x, min, max)   (((x) < (min)) ? (min) : ((x) > (max)) ? (max) : (x))
+#define gcmABS(x)               (((x) < 0) ? -(x) : (x))
+#define gcmNEG(x)               (((x) < 0) ? (x) : -(x))
