+                                                        0x00454,
+                                                        0x00470,
+                                                        16,
+                                                        0, &info.colorKilled[i]));
+        gcmkONERROR(gckHARDWARE_ReadPerformanceRegister(Hardware,
+                                                        0x00454,
+                                                        0x00470,
+                                                        16,
+                                                        2, &info.colorDrawn[i]));
+        gcmkONERROR(gckHARDWARE_ReadPerformanceRegister(Hardware,
+                                                        0x00454,
+                                                        0x00470,
