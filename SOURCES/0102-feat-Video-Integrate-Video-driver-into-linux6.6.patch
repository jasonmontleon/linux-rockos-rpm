+#define LOG_TAG VENC_DEV_NAME ":list"
+#include "vc_drv_log.h"
+
+void init_bi_list_ve(bi_list *list)
+{
+	list->head = NULL;
+	list->tail = NULL;
+}
+
+bi_list_node *bi_list_create_node_ve(void)
+{
+	bi_list_node *node = NULL;
+
+	node = kmalloc(sizeof(bi_list_node), GFP_ATOMIC);
+	if (!node) {
+		LOG_DBG("%s\n", "vmalloc for node fail!");
+		return node;
+	}
+	memset(node, 0, sizeof(bi_list_node));
+	return node;
+}
+
+void bi_list_free_node_ve(bi_list_node *node)
+{
+	//free current node
+	kfree(node);
+}
+
+void bi_list_insert_node_tail_ve(bi_list *list, bi_list_node *current_node)
+{
+	if (!current_node) {
+		LOG_DBG("%s\n", "insert node tail  NULL");
+	}
+	if (list->tail) {
+		current_node->previous = list->tail;
+		list->tail->next = current_node;
+		list->tail = current_node;
+		list->tail->next = NULL;
+	} else {
+		list->head = current_node;
+		list->tail = current_node;
+		current_node->next = NULL;
+		current_node->previous = NULL;
+	}
+}
+
+void bi_list_insert_node_before_ve(bi_list *list, bi_list_node *base_node,
+				bi_list_node *new_node)
+{
+	bi_list_node *temp_node_previous = NULL;
+
+	if (!new_node) {
+		LOG_DBG("%s\n", "insert node before new node NULL");
+		return;
+	}
+	if (base_node) {
+		if (base_node->previous) {
+			//at middle position
+			temp_node_previous = base_node->previous;
+			temp_node_previous->next = new_node;
+			new_node->next = base_node;
+			base_node->previous = new_node;
+			new_node->previous = temp_node_previous;
+		} else {
+			//at head
+			base_node->previous = new_node;
+			new_node->next = base_node;
+			list->head = new_node;
+			new_node->previous = NULL;
+		}
+	} else {
+		//at tail
+		bi_list_insert_node_tail(list, new_node);
+	}
+}
+
+void bi_list_remove_node_ve(bi_list *list, bi_list_node *current_node)
+{
+	bi_list_node *temp_node_previous = NULL;
+	bi_list_node *temp_node_next = NULL;
+
+	if (!current_node) {
+		LOG_DBG("%s\n", "remove node NULL");
+		return;
+	}
+	temp_node_next = current_node->next;
+	temp_node_previous = current_node->previous;
+
+	if (!temp_node_next && !temp_node_previous) {
+		//there is only one node.
+		list->head = NULL;
+		list->tail = NULL;
+	} else if (!temp_node_next) {
+		//at tail
+		list->tail = temp_node_previous;
+		temp_node_previous->next = NULL;
+	} else if (!temp_node_previous) {
+		//at head
+		list->head = temp_node_next;
+		temp_node_next->previous = NULL;
+	} else {
+		//at middle position
+		temp_node_previous->next = temp_node_next;
+		temp_node_next->previous = temp_node_previous;
+	}
+}
