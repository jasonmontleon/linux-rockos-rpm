+
+    gcmkONERROR(gckOS_AtomSet(Hardware->os, fe->freeDscriptors, data));
+
+    /* Enable interrupts. */
+    gcmkONERROR(gckOS_WriteRegisterEx(Hardware->os, Hardware->kernel, 0x000D8, eventEnable));
+
+    *FE = fe;
+
+    gcmkFOOTER_NO();
