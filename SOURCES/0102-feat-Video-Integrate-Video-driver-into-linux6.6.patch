+	u16 submodule_L2Cache_addr; // in byte
+	u16 submodule_MMU_addr[2]; // in byte
+	u16 submodule_axife_addr[2]; // in byte
+} VCMD_CONFIG;
+
+typedef struct {
+	SUBSYS_CONFIG cfg;
+	SUBSYS_CORE_INFO core_info;
+} SUBSYS_DATA;
