+    totalRead = 0;
+    totalWrite = 0;
+
+    /* Walk through all available pixel pipes. */
+    for (i = 0; i < Hardware->identity.pixelPipes; ++i) {
+        /* Select proper pipe. */
+        gcmkONERROR(gckOS_WriteRegisterEx(Hardware->os, Hardware->kernel,
