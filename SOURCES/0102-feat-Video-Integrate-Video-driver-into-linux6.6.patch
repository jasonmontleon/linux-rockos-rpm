+    gcmkVERIFY_ARGUMENT(Bytes > 0);
+    gcmkVERIFY_ARGUMENT(Memory != gcvNULL);
+
+    gcmkONERROR(gckOS_AllocateMemory(Os, Bytes, Memory));
+
+OnError:
+    /* Return the status. */
+    gcmkFOOTER_ARG("*Memory=%p", gcmOPT_POINTER(Memory));
