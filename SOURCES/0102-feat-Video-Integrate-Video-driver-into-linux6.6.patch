+				/* Present */
+				| (1 << 0);
+			WritePageEntry(page_table_entry, page_entry_value);
+		}
+
+		/* Purpose of Bare_metal mode: input bus address==mmu address*/
+		addr->mmu_bus_address = p->mtlb_start << MMU_MTLB_SHIFT |
+					p->stlb_start << MMU_STLB_4K_SHIFT;
+	} else {
+		MMU_ON_ERROR(FindFreeNode(e, &p, page_count));
+
+		SplitFreeNode(e, &p, page_count);
+		LOG_DBG(" *****Node map size*****%d\n", p->page_count);
+
+		p->buf_bus_address = addr->bus_address;
+		p->process_id = GetProcessID();
+		p->filp = NULL;
+
+		for (i = 0; i < page_count; i++) {
+			/* this function used in kernel only,
+			 *so we think it's a contunuous buffer
+			 */
+			address += (i ? PAGE_SIZE : 0);
+			GetPageEntry(p, &page_table_entry, i);
+			ext_addr = ((u32)(address >> 32)) & 0xff;
+			page_entry_value =
+				(address & 0xFFFFF000)
+				/* ext address , physical address bits [39,32]*/
+				| (ext_addr << 4)
+				/* writable */
+				| (1 << 2)
+				/* Ignore exception */
+				| (0 << 1)
+				/* Present */
+				| (1 << 0);
+			WritePageEntry(page_table_entry, page_entry_value);
+		}
+		addr->mmu_bus_address = p->mtlb_start << MMU_MTLB_SHIFT |
+					p->stlb_start << MMU_STLB_4K_SHIFT;
+	}
+	LOG_DBG("KERNEL MMU_MTLB_SHIFT %d MMU_STLB_4K_SHIFT %d\n",
+		 MMU_MTLB_SHIFT, MMU_STLB_4K_SHIFT);
+	LOG_DBG("%s map total %d pages in region %d\nMTLB/STLB starts %d/%d\n",
+		 __func__, page_count, (u32)e, p->mtlb_start, p->stlb_start);
+	LOG_DBG("MTLB/STLB ends %d/%d\n", p->mtlb_end, p->stlb_end);
+	LOG_DBG("%s map 0x%zx -> 0x%zx\n", __func__,
+		 addr->bus_address, addr->mmu_bus_address);
+
+	ReleaseMutex(g_mmu->page_table_mutex);
+
+	return MMU_STATUS_OK;
+
+onerror:
+	if (mutex)
+		ReleaseMutex(g_mmu->page_table_mutex);
+
+	LOG_DBG(" *****MMU Map Error*****\n");
+	return status;
+}
