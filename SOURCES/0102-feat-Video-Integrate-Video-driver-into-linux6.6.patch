+static gctUINT32
+_SETBITS(gctUINT32 Data, gctUINT32 Start, gctUINT32 End, gctUINT32 Value)
+{
+    gctUINT32 data = Data;
+    gctUINT32 mask;
+
+    if (End >= Start) {
+        mask = ((~0ULL >> (63 - End + Start)) << Start);
+        data &= ~mask;
+        data |= ((Value) << Start) & mask;
+        return data;
+    } else {
+        mask = ((~0ULL >> (63 - Start + End)) << End);
+        data &= ~mask;
+        data |= ((Value) << End) & mask;
+        return data;
+    }
+}
+
+static gctUINT32
+_SETBIT(gctUINT32 Data, gctUINT32 Position, gctUINT32 Value)
+{
+    gctUINT32 data;
+
+    data = _SETBITS(Data, Position, Position, Value);
+
+    return data;
+}
+
+static gctUINT32
+_GETBITS(gctUINT32 Data, gctUINT32 Start, gctUINT32 End)
+{
+    gctUINT32 data = Data;
+    gctUINT32 mask;
+
+    if (End >= Start) {
+        mask = (~0ULL >> (63 - (End - Start)));
+        return (data >> Start) & mask;
+    } else {
+        mask = (~0ULL >> (63 - (Start - End)));
+        return (data >> End) & mask;
+        ;
+    }
+}
+
+static gctUINT32
+_GETBIT(gctUINT32 Data, gctUINT32 Position)
+{
+    gctUINT32 data;
+
+    data = _GETBITS(Data, Position, Position);
+
+    return data;
+}
