+	DWEIOC_RESET = 0x100,
+	DWEIOC_S_PARAMS,
+	DWEIOC_ENABLE_BUS,
+	DWEIOC_DISABLE_BUS,
+	DWEIOC_DISABLE_IRQ,
+	DWEIOC_CLEAR_IRQ,
+	DWEIOC_READ_IRQ,
+	DWEIOC_START_DMA_READ,
