+    /* release the irq */
+    if (Device->isrInitializeds[gcvCORE_VG])
+    {
+        intDisconnect((void *)(Device->irqLines[gcvCORE_VG]), isrRoutineVG, (gctPOINTER)gcvCORE_VG);
+
+        Device->isrInitializeds[gcvCORE_VG] = gcvFALSE;
+    }
