+gceSTATUS
+gckKERNEL_PreemptCommitNop(gckKERNEL Kernel, gctUINT32 PriorityID,
+                           gckPREEMPT_COMMIT *PreemptCommit)
+{
+    gceSTATUS status = gcvSTATUS_OK;
