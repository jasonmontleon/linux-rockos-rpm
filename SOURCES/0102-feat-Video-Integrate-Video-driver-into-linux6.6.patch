+
+    /**********************************************************************
+     **
+     **  getGPUPhysical
+     **
+     **  Convert CPU physical address to GPU physical address if they are
+     **  different.
+     */
+    gceSTATUS
+    (*getGPUPhysical)(gcsPLATFORM *Platform, gctPHYS_ADDR_T CPUPhysical, gctPHYS_ADDR_T *GPUPhysical);
+
+    /**********************************************************************
+     **
+     **  getCPUPhysical
+     **
