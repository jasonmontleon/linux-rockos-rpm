+        golden[21] = 0x4;
+        golden[22] = 0xea;
+        golden[23] = 0xfa;
+        golden[24] = 0xf4;
+        golden[25] = 0xd;
+        golden[26] = 0xe;
+        golden[27] = 0xfd;
+        golden[28] = 0xee;
+        golden[29] = 0xff;
+        golden[30] = 0xe6;
+        golden[31] = 0xfc;
+        golden[32] = 0x13;
+        golden[33] = 0x1;
+        golden[34] = 0xf7;
+        golden[35] = 0xdf;
+        golden[36] = 0xe9;
+        golden[37] = 0xec;
+        golden[38] = 0xf;
+        golden[39] = 0xf0;
+        golden[40] = 0xf0;
+        golden[41] = 0xb;
+        golden[42] = 0xa;
+        golden[43] = 0xe7;
+        golden[44] = 0x0;
+        golden[45] = 0xec;
+        golden[46] = 0x1b;
+        golden[47] = 0xf4;
