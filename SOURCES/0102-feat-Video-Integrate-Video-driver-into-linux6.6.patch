+/*******************************************************************************
+ **
+ **  gckOS_AtomicExchange
+ **
+ **  Atomically exchange a pair of 32-bit values.
+ **
+ **  INPUT:
+ **
+ **      gckOS Os
+ **          Pointer to an gckOS object.
+ **
+ **      gctINT32_PTR Target
+ **          Pointer to the 32-bit value to exchange.
+ **
+ **      gctINT32 NewValue
+ **          Specifies a new value for the 32-bit value pointed to by Target.
+ **
+ **      gctINT32_PTR OldValue
+ **          The old value of the 32-bit value pointed to by Target.
+ **
+ **  OUTPUT:
+ **
+ **      Nothing.
+ */
+gceSTATUS
+gckOS_AtomicExchange(gckOS Os, gctUINT32_PTR Target,
+                     gctUINT32 NewValue, gctUINT32_PTR OldValue)
+{
+    /* Exchange the pair of 32-bit values. */
+    *OldValue = (gctUINT32)atomic_xchg((atomic_t *)Target, (int)NewValue);
+    return gcvSTATUS_OK;
+}
+
+/*******************************************************************************
+ **
+ **  gckOS_AtomicExchangePtr
+ **
+ **  Atomically exchange a pair of pointers.
+ **
+ **  INPUT:
+ **
+ **      gckOS Os
+ **          Pointer to an gckOS object.
+ **
+ **      gctPOINTER *Target
+ **          Pointer to the 32-bit value to exchange.
+ **
+ **      gctPOINTER NewValue
+ **          Specifies a new value for the pointer pointed to by Target.
+ **
+ **      gctPOINTER *OldValue
+ **          The old value of the pointer pointed to by Target.
+ **
+ **  OUTPUT:
+ **
+ **      Nothing.
+ */
+gceSTATUS
+gckOS_AtomicExchangePtr(gckOS Os, gctPOINTER *Target,
+                        gctPOINTER NewValue, gctPOINTER *OldValue)
+{
+    /* Exchange the pair of pointers. */
+    *OldValue = (gctPOINTER)(gctUINTPTR_T)atomic_xchg((atomic_t *)Target,
+                                                      (int)(gctUINTPTR_T)NewValue);
+    return gcvSTATUS_OK;
+}
+
+/*******************************************************************************
+ **
+ **  gckOS_AtomicSetMask
+ **
+ **  Atomically set mask to Atom
+ **
+ **  INPUT:
+ **      gctPOINTER Atom
+ **          Pointer to the atom to set.
+ **
+ **      gctUINT32 Mask
+ **          Mask to set.
+ **
+ **  OUTPUT:
+ **
+ **      Nothing.
+ */
+gceSTATUS
+gckOS_AtomSetMask(gctPOINTER Atom, gctUINT32 Mask)
+{
+    gctUINT32 oval, nval;
+
+    do {
+        oval = atomic_read((atomic_t *)Atom);
+        nval = oval | Mask;
+    } while (atomic_cmpxchg((atomic_t *)Atom, oval, nval) != oval);
+
+    return gcvSTATUS_OK;
+}
+
+/*******************************************************************************
+ **
+ **  gckOS_AtomClearMask
+ **
+ **  Atomically clear mask from Atom
+ **
+ **  INPUT:
+ **      gctPOINTER Atom
+ **          Pointer to the atom to clear.
+ **
+ **      gctUINT32 Mask
+ **          Mask to clear.
+ **
+ **  OUTPUT:
+ **
+ **      Nothing.
+ */
+gceSTATUS
+gckOS_AtomClearMask(gctPOINTER Atom, gctUINT32 Mask)
+{
+    gctUINT32 oval, nval;
+
+    do {
+        oval = atomic_read((atomic_t *)Atom);
+        nval = oval & ~Mask;
+    } while (atomic_cmpxchg((atomic_t *)Atom, oval, nval) != oval);
+
+    return gcvSTATUS_OK;
+}
