+    for (i = 0; i < gcvFUNCTION_EXECUTION_NUM; i++) {
+        gctBOOL funcValid = gcvFALSE;
+
+        /* Skip functions since it will perform at special place */
+        if (i == gcvFUNCTION_EXECUTION_MMU || i == gcvFUNCTION_EXECUTION_FLUSH)
