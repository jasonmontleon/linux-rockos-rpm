+
+    gem_obj = drm_gem_object_lookup(file, args->handle);
+    if (!gem_obj)
+        gcmkONERROR(gcvSTATUS_NOT_FOUND);
+
+    viv_obj = container_of(gem_obj, struct viv_gem_object, base);
