+ *       interrupts = <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>,
+ *                   <GIC_SPI 65 IRQ_TYPE_LEVEL_HIGH>;
+ *       interrupt-names = "core_major", "core_3d1";
+ *       clocks = <&clk IMX_SC_R_GPU_0_PID0 IMX_SC_PM_CLK_PER>,
+ *               <&clk IMX_SC_R_GPU_0_PID0 IMX_SC_PM_CLK_MISC>,
