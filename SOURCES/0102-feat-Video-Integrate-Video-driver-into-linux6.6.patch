+        info.writeBytes8[i] = 0;
+        info.cycles[i] = 0;
+        info.idleCycles[i] = 0;
+        info.mcCycles[i] = 0;
+        info.readRequests[i] = 0;
+        info.writeRequests[i] = 0;
+        info.colorKilled[i] = 0;
+        info.colorDrawn[i] = 0;
+        info.depthKilled[i] = 0;
+        info.depthDrawn[i] = 0;
+    }
