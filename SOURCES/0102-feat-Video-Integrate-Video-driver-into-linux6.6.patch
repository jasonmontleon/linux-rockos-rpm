+gceSTATUS
+gckDEVICE_DestroyCores(gckDEVICE Device)
+{
+    gctINT i;
+    gcsCORE_INFO *info = Device->coreInfoArray;
+
+    gcmkHEADER_ARG("Device=%p", Device);
+
+    for (i = Device->coreNum - 1; i >= 0 ; i--) {
+        if (info[i].kernel)
+            gcmkVERIFY_OK(gckKERNEL_Destroy(info[i].kernel));
+    }
+
+    gcmkFOOTER_NO();
+    return gcvSTATUS_OK;
+}
