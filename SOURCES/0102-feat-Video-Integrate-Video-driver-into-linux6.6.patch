+    Data->bufVidMem = bufferNode;
+    Data->bufVidMemBytes = bufferBytes;
+    Data->address = bufferAddress;
+    Data->logical = bufferLogical;
+    Data->bytes = bytes;
+
+    gcmkFOOTER_NO();
