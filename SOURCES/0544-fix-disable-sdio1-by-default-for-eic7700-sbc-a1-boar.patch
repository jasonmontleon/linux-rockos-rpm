From 34415e8ccf5d86d98a99452a681ab791a7c95dda Mon Sep 17 00:00:00 2001
From: Min Lin <linmin@eswincomputing.com>
Date: Fri, 4 Jul 2025 14:31:20 +0800
Subject: [PATCH 544/652] fix: disable sdio1 by default for eic7700-sbc-a1
 board

Signed-off-by: Min Lin <linmin@eswincomputing.com>
---
 arch/riscv/boot/dts/eswin/eic7700-sbc-a1.dts | 28 +-------------------
 1 file changed, 1 insertion(+), 27 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7700-sbc-a1.dts b/arch/riscv/boot/dts/eswin/eic7700-sbc-a1.dts
index 690f4f2f6f402..8dfe46c4b3dc9 100644
--- a/arch/riscv/boot/dts/eswin/eic7700-sbc-a1.dts
+++ b/arch/riscv/boot/dts/eswin/eic7700-sbc-a1.dts
@@ -473,33 +473,7 @@ &sdio0 {
 
 &sdio1 {
 	/* wifi module */
-	status = "okay";
-	delay_code = <0x29>;
-	drive-impedance-ohm = <33>;
-	enable-cmd-pullup;
-	enable-data-pullup;
-	keep-power-in-suspend;
-	non-removable;
-	no-sd;
-	no-mmc;
-	vqmmc-supply = <&reg_vcc1v8>;
-	aw3155:wifi_aw3155@0 {
-		compatible = "aml_w1_sdio";
-		reg = <0x0>;
-		interrupt-parent = <&porta>;
-		interrupts = <15 IRQ_TYPE_LEVEL_LOW>;
-		pinctrl-names = "default", "default";
-		pinctrl-0 = <&pinctrl_gpio15_default>;
-		pinctrl-1 = <&pinctrl_gpio34_default>;
-		irq-gpios = <&porta 15 GPIO_ACTIVE_HIGH>;
-		rst-gpios = <&portb 2 GPIO_ACTIVE_HIGH>;
-	};
-	mdhd_wlan {
-		compatible = "android,bcmdhd_wlan";
-		pinctrl-names = "default";
-		pinctrl-0 = <&pinctrl_gpio34_default>;
-		gpio_wl_reg_on = <&portb 2 GPIO_ACTIVE_HIGH>;
-	};
+	status = "disabled";
 };
 
 &d0_gmac0 {
-- 
2.53.0

