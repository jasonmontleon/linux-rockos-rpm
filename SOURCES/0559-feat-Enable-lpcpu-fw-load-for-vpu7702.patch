From f2b678446ce5a242ad403bfe134cc7f07e47a3ab Mon Sep 17 00:00:00 2001
From: taohaitao <taohaitao@eswincomputing.com>
Date: Thu, 5 Jun 2025 18:26:54 +0800
Subject: [PATCH 559/652] feat:Enable lpcpu fw load for vpu7702

Changelogs:
Enable lpcpu fw for vpu7702

Signed-off-by: taohaitao <taohaitao@eswincomputing.com>
---
 arch/riscv/boot/dts/eswin/vpu7702-evb.dts  | 8 ++++----
 arch/riscv/boot/dts/eswin/vpu7702-pcie.dts | 8 ++++----
 2 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/vpu7702-evb.dts b/arch/riscv/boot/dts/eswin/vpu7702-evb.dts
index 40a64648d88f4..21d2c8c083b67 100644
--- a/arch/riscv/boot/dts/eswin/vpu7702-evb.dts
+++ b/arch/riscv/boot/dts/eswin/vpu7702-evb.dts
@@ -843,7 +843,7 @@ &fan_control {
 
 &d0_i2c0 {
 	/* codec es8388 */
-	status = "okay";
+	status = "disabled";
 	d0_es8388_0: es8388-0@10 {
 		compatible = "eswin,es8388";
 		reg = <0x10>;
@@ -892,7 +892,7 @@ npu_vcc1:npu_svcc{
 
 &d0_i2c2 {
 	/* touch screen*/
-	status = "ok";
+	status = "disabled";
 	gt911:touchscreen@14 {
 		compatible = "goodix,gt911";
 		reg = <0x14>;
@@ -907,7 +907,7 @@ gt911:touchscreen@14 {
 
 &d0_i2c3 {
 	/* mipi csi0/csi1 */
-	status = "okay";
+	status = "disabled";
 };
 
 &d0_i2c4 {
@@ -963,7 +963,7 @@ &d0_i2c9 {
 
 &d0_aon_i2c0 {
 	/* temp sensor & rtc */
-	status = "okay";
+	status = "disabled";
 	eswin,syscfg = <&d0_sys_con 0x3C0 16>;
 	pcf_rtc:rtc@51 {
 		compatible = "nxp,pcf8563";
diff --git a/arch/riscv/boot/dts/eswin/vpu7702-pcie.dts b/arch/riscv/boot/dts/eswin/vpu7702-pcie.dts
index 81d0576394f36..22a63047b779c 100644
--- a/arch/riscv/boot/dts/eswin/vpu7702-pcie.dts
+++ b/arch/riscv/boot/dts/eswin/vpu7702-pcie.dts
@@ -827,7 +827,7 @@ &fan_control {
 
 &d0_i2c0 {
 	/* 12V_DC_IN */
-	status = "okay";
+	status = "disabled";
 	i2c-sda-hold-time-ns = <0x40>;
 	ina226@44 {
 		compatible = "ti,ina226";
@@ -861,7 +861,7 @@ npu_vcc1:npu_svcc{
 
 &d0_i2c2 {
 	/* Temperature Sensor */
-	status = "okay";
+	status = "disabled";
 	tmp102@48 {
 		compatible = "ti,tmp102";
 		reg = <0x48>;
@@ -882,7 +882,7 @@ &d0_i2c4 {
 
 &d0_i2c5 {
 	/* AT24C02C EEPROM */
-	status = "okay";
+	status = "disabled";
 	eswin,syscfg = <&d0_sys_con 0x3C0 16>;
 	eeprom@50 {
 		compatible = "atmel,24c02";
@@ -915,7 +915,7 @@ &d0_aon_i2c0 {
 	clock-frequency = <400000>;
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_i2c10_default>;
-	status = "okay";
+	status = "disabled";
 
 	adc@48 {
 		compatible = "ti,ads1115";
-- 
2.51.0

