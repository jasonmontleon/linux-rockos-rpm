From 44f5a1edabf1230ccf64f6d2e7c0e34389922201 Mon Sep 17 00:00:00 2001
From: gengzonglin <gengzonglin@eswincomputing.com>
Date: Thu, 12 Jun 2025 09:41:33 +0800
Subject: [PATCH 551/652] fix:Fix 'invalid GPIO' for D560 gmac

Changelogs:
	1.Fix "invalid GPIO" for D560 gmac.

Signed-off-by: gengzonglin gengzonglin@eswincomputing.com
---
 arch/riscv/boot/dts/eswin/eic7702-som560-interleave.dtsi | 4 ++--
 arch/riscv/boot/dts/eswin/eic7702-som560.dtsi            | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-som560-interleave.dtsi b/arch/riscv/boot/dts/eswin/eic7702-som560-interleave.dtsi
index 2e55ba76ad50..c99a7f59c2e1 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-som560-interleave.dtsi
+++ b/arch/riscv/boot/dts/eswin/eic7702-som560-interleave.dtsi
@@ -980,7 +980,7 @@ &d1_gmac0 {
 &d0_gmac1 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_die0_gpio34_default>;
-	rst-gpios = <&porta 34 GPIO_ACTIVE_LOW>;
+	rst-gpios = <&portb 2 GPIO_ACTIVE_LOW>;
 	eswin,rgmiisel = <&pinctrl 0x294 0x3>;
 	eswin,led-cfgs = <0x6100 0xa40 0x420>;
 	dly-param-1000m = <0x20202020 0x46205020 0x20202020>;
@@ -992,7 +992,7 @@ &d0_gmac1 {
 &d1_gmac1 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_die1_gpio34_default>;
-	rst-gpios = <&d1_porta 34 GPIO_ACTIVE_LOW>;
+	rst-gpios = <&d1_portb 2 GPIO_ACTIVE_LOW>;
 	eswin,rgmiisel = <&d1_pinctrl 0x294 0x3>;
 	eswin,led-cfgs = <0x6100 0xa40 0x420>;
 	dly-param-1000m = <0x20202020 0x46205A20 0x20202020>;
diff --git a/arch/riscv/boot/dts/eswin/eic7702-som560.dtsi b/arch/riscv/boot/dts/eswin/eic7702-som560.dtsi
index 12ef6270c441..80ad529aafc0 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-som560.dtsi
+++ b/arch/riscv/boot/dts/eswin/eic7702-som560.dtsi
@@ -941,7 +941,7 @@ &d1_gmac0 {
 &d0_gmac1 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_die0_gpio34_default>;
-	rst-gpios = <&porta 34 GPIO_ACTIVE_LOW>;
+	rst-gpios = <&portb 2 GPIO_ACTIVE_LOW>;
 	eswin,rgmiisel = <&pinctrl 0x294 0x3>;
 	eswin,led-cfgs = <0x6100 0xa40 0x420>;
 	dly-param-1000m = <0x20202020 0x46205020 0x20202020>;
@@ -953,7 +953,7 @@ &d0_gmac1 {
 &d1_gmac1 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_die1_gpio34_default>;
-	rst-gpios = <&d1_porta 34 GPIO_ACTIVE_LOW>;
+	rst-gpios = <&d1_portb 2 GPIO_ACTIVE_LOW>;
 	eswin,rgmiisel = <&d1_pinctrl 0x294 0x3>;
 	eswin,led-cfgs = <0x6100 0xa40 0x420>;
 	dly-param-1000m = <0x20202020 0x46205A20 0x20202020>;
-- 
