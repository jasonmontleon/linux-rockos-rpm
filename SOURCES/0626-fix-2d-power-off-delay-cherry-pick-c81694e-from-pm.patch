From 97194ab034ac346b44e374a8b31b3e116b79802c Mon Sep 17 00:00:00 2001
From: lei <leizhilin@eswincomputing.com>
Date: Mon, 14 Jul 2025 20:50:20 +0800
Subject: [PATCH 626/652] fix(2d):power off delay,cherry-pick c81694e from pm

Changelogs:

1.revert commit http://10.10.130.10:8080/c/win2030/linux-6.6/+/20772;
2.solution:
	1)use gcvPOWER_OFF_TIMEOUT only to avoid hardware report isr after power off;
	2)use delay 1000ms to timer, if any gcvPOWER_ON comes, clear nextPowerState;
        3)when power off, wait 1ms wait pm flush cache interrupt come;

Signed-off-by: lei <leizhilin@eswincomputing.com>
---
 .../hal/kernel/arch/gc_hal_kernel_hardware.c  | 31 +++++++++++++------
 .../eswin/hae/hal/kernel/inc/gc_hal_options.h |  2 +-
 .../os/linux/kernel/gc_hal_kernel_device.c    |  3 +-
 .../os/linux/kernel/gc_hal_kernel_driver.c    |  2 ++
 4 files changed, 27 insertions(+), 11 deletions(-)

diff --git a/drivers/staging/media/eswin/hae/hal/kernel/arch/gc_hal_kernel_hardware.c b/drivers/staging/media/eswin/hae/hal/kernel/arch/gc_hal_kernel_hardware.c
index c9c0812f10612..4bf68c449b889 100644
--- a/drivers/staging/media/eswin/hae/hal/kernel/arch/gc_hal_kernel_hardware.c
+++ b/drivers/staging/media/eswin/hae/hal/kernel/arch/gc_hal_kernel_hardware.c
@@ -5200,6 +5200,19 @@ gckHARDWARE_PowerControlClusters(gckHARDWARE Hardware,
 
     command = Hardware->kernel->command;
 
+    do {
+        gckOS_Delay(Hardware->os, 100);
+
+        gcmkONERROR(gckOS_ReadRegisterEx(Hardware->os, Hardware->kernel,
+                                            0x00004, &idle));
+
+        timer++;
+        if (timer >= 5) {
+            hae_print("core: %d, wait register idl: 0x%x timeout!", Hardware->core, idle);
+            break;
+        }
+    } while (!_IsHWIdle(idle, Hardware));
+
 #if !gcdFPGA_BUILD
     if (Hardware->identity.customerID != 0x85 || !Hardware->mcFE ||
         Hardware->options.enableNNClusters == (gctUINT32)~0UL ||
@@ -6183,6 +6196,15 @@ gckHARDWARE_SetPowerState(gckHARDWARE Hardware, gceCHIPPOWERSTATE State)
     }
 
 #if gcdPOWEROFF_TIMEOUT
+    if (state == gcvPOWER_ON) {
+        Hardware->nextPowerState = gcvPOWER_INVALID;
+    }
+
+    if (broadcast && !timeout && state == gcvPOWER_OFF) {
+        status = gcvSTATUS_OK;
+        goto OnError;
+    }
+
     if (timeout && Hardware->nextPowerState == gcvPOWER_INVALID) {
         /* Delayed power state change is canceled. */
         status = gcvSTATUS_OK;
@@ -6336,15 +6358,6 @@ gckHARDWARE_SetPowerState(gckHARDWARE Hardware, gceCHIPPOWERSTATE State)
 #endif
 
 #if gcdPOWEROFF_TIMEOUT
-    if (!broadcast) {
-        /*
-         * Cancel delayed power state change.
-         * Stop timer is not as good as set as no state change. Timer may run
-         * into this function already when try to stop the timer.
-         */
-        Hardware->nextPowerState = gcvPOWER_INVALID;
-    }
-
     if (Hardware->powerOffTimeout &&
         (state == gcvPOWER_IDLE || state == gcvPOWER_SUSPEND)) {
         /* Delayed power off. */
diff --git a/drivers/staging/media/eswin/hae/hal/kernel/inc/gc_hal_options.h b/drivers/staging/media/eswin/hae/hal/kernel/inc/gc_hal_options.h
index 7215038503f18..7f408288dd24a 100644
--- a/drivers/staging/media/eswin/hae/hal/kernel/inc/gc_hal_options.h
+++ b/drivers/staging/media/eswin/hae/hal/kernel/inc/gc_hal_options.h
@@ -695,7 +695,7 @@
  *       timeout in milliseconds.
  */
 #ifndef gcdPOWEROFF_TIMEOUT
-#define gcdPOWEROFF_TIMEOUT                     1000
+#define gcdPOWEROFF_TIMEOUT                     3000
 #endif
 
 /*
diff --git a/drivers/staging/media/eswin/hae/hal/os/linux/kernel/gc_hal_kernel_device.c b/drivers/staging/media/eswin/hae/hal/os/linux/kernel/gc_hal_kernel_device.c
index 67e66b7734232..c6f03e6bab453 100644
--- a/drivers/staging/media/eswin/hae/hal/os/linux/kernel/gc_hal_kernel_device.c
+++ b/drivers/staging/media/eswin/hae/hal/os/linux/kernel/gc_hal_kernel_device.c
@@ -2280,7 +2280,8 @@ isrRoutine(int irq, void *ctxt)
     }
 
     if(status == gcvSTATUS_GENERIC_IO){
-        pr_info("[%s] hae isr meet clock close...\n", __func__);
+        hae_print("irq: %d, core: %d, addr: %llx clock close.\n",
+            irq, kernel->core, kernel->hardware->lastExecuteAddress);
     }
 
     return IRQ_NONE;
diff --git a/drivers/staging/media/eswin/hae/hal/os/linux/kernel/gc_hal_kernel_driver.c b/drivers/staging/media/eswin/hae/hal/os/linux/kernel/gc_hal_kernel_driver.c
index b7481fdb4a01a..eae6ecbf41a00 100644
--- a/drivers/staging/media/eswin/hae/hal/os/linux/kernel/gc_hal_kernel_driver.c
+++ b/drivers/staging/media/eswin/hae/hal/os/linux/kernel/gc_hal_kernel_driver.c
@@ -1555,6 +1555,7 @@ static int viv_dev_suspend(struct platform_device *dev, pm_message_t state)
                     return -1;
                 }
 
+                hae_print("hard: %p, store_state: %d, power off.", device->kernels[i]->hardware, device->statesStored[i]);
                 status = gckHARDWARE_SetPowerState(device->kernels[i]->hardware, gcvPOWER_OFF);
                 if (gcmIS_ERROR(status)) {
                     return -1;
@@ -1608,6 +1609,7 @@ static int viv_dev_resume(struct platform_device *dev)
                     break;
                 }
 
+                hae_print("hard: %p, store_state: %d, resume.", device->kernels[i]->hardware, statesStored);
                 /* Restore states. */
                 status = gckHARDWARE_SetPowerState(device->kernels[i]->hardware, statesStored);
                 if (gcmIS_ERROR(status)) {
-- 
