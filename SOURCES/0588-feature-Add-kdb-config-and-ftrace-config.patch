From 42206ee8e6fd36ad6dfcf63b3a05593f44e54764 Mon Sep 17 00:00:00 2001
From: chenzhanzhan <chenzhanzhan@eswincomputing.com>
Date: Thu, 26 Jun 2025 17:45:11 +0800
Subject: [PATCH 588/654] feature: Add kdb config and ftrace config

Changelogs:
1. Add kdb config and ftrace config

Signed-off-by: chenzhanzhan <chenzhanzhan@eswincomputing.com>
---
 arch/riscv/configs/eic7700_dbg_defconfig | 8 ++++----
 arch/riscv/configs/eic7702_dbg_defconfig | 7 ++++---
 2 files changed, 8 insertions(+), 7 deletions(-)

diff --git a/arch/riscv/configs/eic7700_dbg_defconfig b/arch/riscv/configs/eic7700_dbg_defconfig
index 2dbc8bd0bfa5..4db3ce7e6f6f 100644
--- a/arch/riscv/configs/eic7700_dbg_defconfig
+++ b/arch/riscv/configs/eic7700_dbg_defconfig
@@ -36,7 +36,7 @@ CONFIG_SMP=y
 CONFIG_HOTPLUG_CPU=y
 CONFIG_RISCV_SBI_V01=y
 # CONFIG_RISCV_BOOT_SPINWAIT is not set
-CONFIG_CMDLINE="earlycon=sbi console=ttyS0,115200n8 clk_ignore_unused cma_pernuma=0x2000000 disable_bypass=false firmware_class.path=/lib/firmware/eic7x/"
+CONFIG_CMDLINE="earlycon=sbi console=ttyS0,115200n8 clk_ignore_unused cma_pernuma=0x2000000 disable_bypass=false firmware_class.path=/lib/firmware/eic7x/ kgdboc=ttyS0,115200 ftrace_dump_on_oops=1"
 CONFIG_CMDLINE_EXTEND=y
 # CONFIG_SUSPEND is not set
 CONFIG_CPU_FREQ=y
@@ -819,9 +819,11 @@ CONFIG_CONSOLE_LOGLEVEL_DEFAULT=15
 CONFIG_CONSOLE_LOGLEVEL_QUIET=15
 CONFIG_MESSAGE_LOGLEVEL_DEFAULT=7
 CONFIG_DYNAMIC_DEBUG=y
+CONFIG_KGDB=y
+CONFIG_KGDB_KDB=y
+CONFIG_KDB_KEYBOARD=y
 CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
 CONFIG_MAGIC_SYSRQ=y
-CONFIG_KGDB=y
 CONFIG_DEBUG_PAGEALLOC=y
 CONFIG_DEBUG_KMEMLEAK=y
 CONFIG_DEBUG_OBJECTS=y
@@ -844,9 +846,7 @@ CONFIG_DEBUG_ATOMIC_SLEEP=y
 CONFIG_DEBUG_LIST=y
 CONFIG_DEBUG_PLIST=y
 CONFIG_DEBUG_SG=y
-# CONFIG_RCU_TRACE is not set
 CONFIG_RCU_EQS_DEBUG=y
-# CONFIG_FTRACE is not set
 # CONFIG_RUNTIME_TESTING_MENU is not set
 CONFIG_MEMTEST=y
 CONFIG_BCMDHD=m
diff --git a/arch/riscv/configs/eic7702_dbg_defconfig b/arch/riscv/configs/eic7702_dbg_defconfig
index caf1d0cba4cb..174f6aac9374 100644
--- a/arch/riscv/configs/eic7702_dbg_defconfig
+++ b/arch/riscv/configs/eic7702_dbg_defconfig
@@ -41,7 +41,7 @@ CONFIG_HOTPLUG_CPU=y
 CONFIG_NUMA=y
 CONFIG_RISCV_SBI_V01=y
 # CONFIG_RISCV_BOOT_SPINWAIT is not set
-CONFIG_CMDLINE="earlycon=sbi console=ttyS0,115200n8 clk_ignore_unused cma_pernuma=0x20000000 disable_bypass=false firmware_class.path=/lib/firmware/eic7x/"
+CONFIG_CMDLINE="earlycon=sbi console=ttyS0,115200n8 clk_ignore_unused cma_pernuma=0x20000000 disable_bypass=false firmware_class.path=/lib/firmware/eic7x/ kgdboc=ttyS0,115200 ftrace_dump_on_oops=1"
 CONFIG_CMDLINE_EXTEND=y
 # CONFIG_SUSPEND is not set
 CONFIG_CPU_FREQ=y
@@ -851,6 +851,9 @@ CONFIG_CONSOLE_LOGLEVEL_DEFAULT=15
 CONFIG_CONSOLE_LOGLEVEL_QUIET=7
 CONFIG_MESSAGE_LOGLEVEL_DEFAULT=7
 CONFIG_DYNAMIC_DEBUG=y
+CONFIG_KGDB=y
+CONFIG_KGDB_KDB=y
+CONFIG_KDB_KEYBOARD=y
 CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
 CONFIG_MAGIC_SYSRQ=y
 CONFIG_DEBUG_PAGEALLOC=y
@@ -871,9 +874,7 @@ CONFIG_DEBUG_ATOMIC_SLEEP=y
 CONFIG_DEBUG_LIST=y
 CONFIG_DEBUG_PLIST=y
 CONFIG_DEBUG_SG=y
-# CONFIG_RCU_TRACE is not set
 CONFIG_RCU_EQS_DEBUG=y
-# CONFIG_FTRACE is not set
 # CONFIG_RUNTIME_TESTING_MENU is not set
 CONFIG_MEMTEST=y
 CONFIG_BCMDHD=m
-- 
2.51.0

