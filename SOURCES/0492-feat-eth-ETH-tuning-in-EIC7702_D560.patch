From 087db42292d99880d0bec0755cd2dc97631bd2a7 Mon Sep 17 00:00:00 2001
From: lizhi2 <lizhi2@eswincomputing.com>
Date: Wed, 30 Apr 2025 13:26:06 +0800
Subject: [PATCH 492/652] feat(eth): ETH tuning in EIC7702_D560

Changelogs:
1. update dly-param in dts by tuning ethernet

Signed-off-by: lizhi2 <lizhi2@eswincomputing.com>
---
 arch/riscv/boot/dts/eswin/eic7702-som560.dtsi | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-som560.dtsi b/arch/riscv/boot/dts/eswin/eic7702-som560.dtsi
index de69bc2359e4..ed5392ae9035 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-som560.dtsi
+++ b/arch/riscv/boot/dts/eswin/eic7702-som560.dtsi
@@ -915,8 +915,8 @@ &d0_gmac0 {
 	rst-gpios = <&porta 29 GPIO_ACTIVE_LOW>;
 	eswin,rgmiisel = <&pinctrl 0x290 0x3>;
 	eswin,led-cfgs = <0x6100 0xa40 0x420>;
-	dly-param-1000m = <0x23232323 0x5a0c6423 0x0c0c0c0c>;
-	dly-param-100m = <0x50505050 0x803f8050 0x3f3f3f3f>;
+	dly-param-1000m = <0x20202020 0x96206420 0x20202020>;
+	dly-param-100m = <0x20202020 0x96205A20 0x20202020>;
 	dly-param-10m = <0 0 0>;
 	status = "okay";
 };
@@ -927,8 +927,8 @@ &d1_gmac0 {
 	rst-gpios = <&d1_porta 29 GPIO_ACTIVE_LOW>;
 	eswin,rgmiisel = <&d1_pinctrl 0x290 0x3>;
 	eswin,led-cfgs = <0x6100 0xa40 0x420>;
-	dly-param-1000m = <0x23232323 0x5a0c6423 0x0c0c0c0c>;
-	dly-param-100m = <0x50505050 0x803f8050 0x3f3f3f3f>;
+	dly-param-1000m = <0x20202020 0x8C205A20 0x20202020>;
+	dly-param-100m = <0x20202020 0x96205A20 0x20202020>;
 	dly-param-10m = <0 0 0>;
 	status = "okay";
 };
@@ -939,8 +939,8 @@ &d0_gmac1 {
 	rst-gpios = <&porta 34 GPIO_ACTIVE_LOW>;
 	eswin,rgmiisel = <&pinctrl 0x294 0x3>;
 	eswin,led-cfgs = <0x6100 0xa40 0x420>;
-	dly-param-1000m = <0x25252525 0x5a266425 0x26262626>;
-	dly-param-100m = <0x48484848 0x80588048 0x58585858>;
+	dly-param-1000m = <0x20202020 0x46205020 0x20202020>;
+	dly-param-100m = <0x20202020 0x50205020 0x20202020>;
 	dly-param-10m = <0 0 0>;
 	status = "okay";
 };
@@ -951,8 +951,8 @@ &d1_gmac1 {
 	rst-gpios = <&d1_porta 34 GPIO_ACTIVE_LOW>;
 	eswin,rgmiisel = <&d1_pinctrl 0x294 0x3>;
 	eswin,led-cfgs = <0x6100 0xa40 0x420>;
-	dly-param-1000m = <0x25252525 0x5a266425 0x26262626>;
-	dly-param-100m = <0x48484848 0x80588048 0x58585858>;
+	dly-param-1000m = <0x20202020 0x46205A20 0x20202020>;
+	dly-param-100m = <0x20202020 0x50205A20 0x20202020>;
 	dly-param-10m = <0 0 0>;
 	status = "okay";
 };
