From 0a1e1594f8ca40559d75df344d605386fcf9ecc9 Mon Sep 17 00:00:00 2001
From: ningyu <ningyu@eswincomputing.com>
Date: Thu, 21 Nov 2024 20:09:03 +0800
Subject: [PATCH 287/652] WIN2030-16035:refactor:remove ecc range from 7702 evb

Changelogs:
Remove ECC range from 7702 EVB default

Change-Id: I7a9e7993bd76d4c6ec6386dcadc3e12201cb1e91
Signed-off-by: ningyu <ningyu@eswincomputing.com>
---
 arch/riscv/boot/dts/eswin/eic7702-evb-a1.dts | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-evb-a1.dts b/arch/riscv/boot/dts/eswin/eic7702-evb-a1.dts
index f6b416a65a95b..d26e6e5f505f0 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-evb-a1.dts
+++ b/arch/riscv/boot/dts/eswin/eic7702-evb-a1.dts
@@ -24,8 +24,8 @@
 #define LSPCLK_FREQ		200000000
 
 /* If wanna enable ECC capability of DDR, should reserve highest zone of 1/8 all space for it */
-#define MEMORY_SIZE_H		0x3
-#define MEMORY_SIZE_L		0x80000000
+#define MEMORY_SIZE_H		0x4
+#define MEMORY_SIZE_L		0x0
 #define CMA_SIZE		0x20000000
 
 #include "eswin-win2030-die0-soc.dtsi"
@@ -122,9 +122,14 @@ g2d_8GB_boundary_reserved_4k {
 			reg = <0x1 0xfffff000 0x0 0x1000>;
 		};
 
+		g2d_12GB_boundary_reserved_4k {
+			no-map;
+			reg = <0x2 0xfffff000 0x0 0x1000>;
+		};
+
 		mmz_nid_0_part_0 {
 			compatible = "eswin-reserve-memory";
-			reg = <0x2 0x80000000 0x1 0x80000000>;
+			reg = <0x3 0x0 0x1 0x80000000>;
 			no-map;
 		};
 
@@ -140,7 +145,7 @@ d1_g2d_8GB_boundary_reserved_4k {
 
 		mmz_nid_1_part_0 {
 			compatible = "eswin-reserve-memory";
-			reg = <0x22 0x0 0x1 0x80000000>;
+			reg = <0x22 0x80000000 0x1 0x80000000>;
 			no-map;
 		};
 	};
-- 
2.53.0

