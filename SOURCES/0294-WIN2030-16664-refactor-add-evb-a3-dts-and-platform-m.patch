 arch/riscv/boot/dts/eswin/eic7700-evb-a2.dts  |  2 +-
 arch/riscv/boot/dts/eswin/eic7700-evb-a3.dts  | 55 +++++++++++++++++++
 arch/riscv/boot/dts/eswin/eic7700-evb.dts     |  2 +-
 .../dts/eswin/eic7700-hifive-premier-p550.dts | 10 ++++
