 	#address-cells = <2>;
 	#size-cells = <2>;
-	model = "ESWIN EIC7702";
+	model = "ESWIN EIC7702 EVB A1";
 	compatible = "sifive,hifive-unmatched-a00", "sifive,fu740-c000",
