From a2e5823c735d991f534cf480363ed865b9110dfc Mon Sep 17 00:00:00 2001
From: Jason Montleon <jason@montleon.com>
Date: Sat, 22 Feb 2025 21:33:23 -0500
Subject: [PATCH 548/551] remove mmz vb reserved memory ranges

---
 arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts | 6 ------
 arch/riscv/boot/dts/eswin/eic7700-milkv-megrez.dts        | 6 ------
 arch/riscv/boot/dts/eswin/eic7700-pine64-starpro64.dts    | 6 ------
 3 files changed, 18 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts b/arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts
index ae401ec96ddd..77e435214099 100644
--- a/arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts
+++ b/arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts
@@ -106,12 +106,6 @@ g2d_12GB_boundary_reserved_4k {
 			reg = <0x2 0xfffff000 0x0 0x1000>;
 		};
 
-		mmz_nid_0_part_0 {
-			compatible = "eswin-reserve-memory";
-			reg = <0x3 0x0 0x1 0x80000000>;
-			no-map;
-		};
-
 		dvp2axi_mem: dvp2axi-mem@90000000 {
 			compatible = "shared-dma-pool";
 			reg = <0x0 0x90000000 0x0 0x10000000>;
diff --git a/arch/riscv/boot/dts/eswin/eic7700-milkv-megrez.dts b/arch/riscv/boot/dts/eswin/eic7700-milkv-megrez.dts
index d04b2606d54b..23b2948663b7 100644
--- a/arch/riscv/boot/dts/eswin/eic7700-milkv-megrez.dts
+++ b/arch/riscv/boot/dts/eswin/eic7700-milkv-megrez.dts
@@ -108,12 +108,6 @@ g2d_12GB_boundary_reserved_4k {
 			no-map;
 			reg = <0x2 0xfffff000 0x0 0x1000>;
 		};
-
-		mmz_nid_0_part_0 {
-			compatible = "eswin-reserve-memory";
-			reg = <0x3 0x0 0x1 0x80000000>;
-			no-map;
-		};
 	};
 
 	leds {
diff --git a/arch/riscv/boot/dts/eswin/eic7700-pine64-starpro64.dts b/arch/riscv/boot/dts/eswin/eic7700-pine64-starpro64.dts
index 7f71dd33b71f..d0d755be9dc2 100644
--- a/arch/riscv/boot/dts/eswin/eic7700-pine64-starpro64.dts
+++ b/arch/riscv/boot/dts/eswin/eic7700-pine64-starpro64.dts
@@ -96,12 +96,6 @@ g2d_12GB_boundary_reserved_4k {
 			no-map;
 			reg = <0x2 0xfffff000 0x0 0x1000>;
 		};
-
-		mmz_nid_0_part_0 {
-			compatible = "eswin-reserve-memory";
-			reg = <0x3 0x0 0x1 0x80000000>;
-			no-map;
-		};
 	};
 
 	leds {
