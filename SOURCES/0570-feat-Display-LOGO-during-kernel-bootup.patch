From 5d73a8a2c915bb3c89b10fe0ddea60e55711a453 Mon Sep 17 00:00:00 2001
From: denglei <denglei@eswincomputing.com>
Date: Thu, 19 Jun 2025 09:40:38 +0800
Subject: [PATCH 570/652] feat:Display LOGO during kernel bootup.

Changelogs:
	Display LOGO during kernel bootup.

Signed-off-by: denglei <denglei@eswincomputing.com>
---
 arch/riscv/configs/eic7700_defconfig | 12 +++++++++++-
 arch/riscv/configs/eic7702_defconfig | 12 +++++++++++-
 2 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/arch/riscv/configs/eic7700_defconfig b/arch/riscv/configs/eic7700_defconfig
index 9261a4b9cbf7..8166eb144e00 100644
--- a/arch/riscv/configs/eic7700_defconfig
+++ b/arch/riscv/configs/eic7700_defconfig
@@ -666,6 +666,16 @@ CONFIG_DRM_LEGACY=y
 CONFIG_FB=y
 CONFIG_FB_RADEON=m
 CONFIG_FB_SIMPLE=m
+CONFIG_VGA_CONSOLE=y
+CONFIG_DUMMY_CONSOLE=y
+CONFIG_DUMMY_CONSOLE_COLUMNS=80
+CONFIG_DUMMY_CONSOLE_ROWS=25
+CONFIG_FRAMEBUFFER_CONSOLE=y
+CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
+CONFIG_LOGO=y
+CONFIG_LOGO_LINUX_MONO=y
+CONFIG_LOGO_LINUX_VGA16=y
+CONFIG_LOGO_LINUX_CLUT224=y
 CONFIG_SOUND=y
 CONFIG_SND=y
 CONFIG_SND_HDA_INTEL=m
@@ -852,7 +862,7 @@ CONFIG_CRC7=y
 CONFIG_DMA_CMA=y
 CONFIG_PRINTK_TIME=y
 CONFIG_CONSOLE_LOGLEVEL_DEFAULT=15
-CONFIG_CONSOLE_LOGLEVEL_QUIET=15
+CONFIG_CONSOLE_LOGLEVEL_QUIET=7
 CONFIG_MESSAGE_LOGLEVEL_DEFAULT=7
 CONFIG_DYNAMIC_DEBUG=y
 CONFIG_DEBUG_FS=y
diff --git a/arch/riscv/configs/eic7702_defconfig b/arch/riscv/configs/eic7702_defconfig
index 48d08ffb7203..4fcedf262fd2 100644
--- a/arch/riscv/configs/eic7702_defconfig
+++ b/arch/riscv/configs/eic7702_defconfig
@@ -651,6 +651,16 @@ CONFIG_DRM_LEGACY=y
 CONFIG_FB=y
 CONFIG_FB_RADEON=m
 CONFIG_FB_SIMPLE=m
+CONFIG_VGA_CONSOLE=y
+CONFIG_DUMMY_CONSOLE=y
+CONFIG_DUMMY_CONSOLE_COLUMNS=80
+CONFIG_DUMMY_CONSOLE_ROWS=25
+CONFIG_FRAMEBUFFER_CONSOLE=y
+CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
+CONFIG_LOGO=y
+CONFIG_LOGO_LINUX_MONO=y
+CONFIG_LOGO_LINUX_VGA16=y
+CONFIG_LOGO_LINUX_CLUT224=y
 CONFIG_SOUND=y
 CONFIG_SND=y
 CONFIG_SND_HDA_INTEL=m
@@ -834,7 +844,7 @@ CONFIG_DMA_NUMA_CMA=y
 CONFIG_CMA_SIZE_MBYTES=512
 CONFIG_PRINTK_TIME=y
 CONFIG_CONSOLE_LOGLEVEL_DEFAULT=15
-CONFIG_CONSOLE_LOGLEVEL_QUIET=15
+CONFIG_CONSOLE_LOGLEVEL_QUIET=7
 CONFIG_MESSAGE_LOGLEVEL_DEFAULT=7
 CONFIG_DYNAMIC_DEBUG=y
 CONFIG_DEBUG_PAGEALLOC=y
-- 
2.54.0

