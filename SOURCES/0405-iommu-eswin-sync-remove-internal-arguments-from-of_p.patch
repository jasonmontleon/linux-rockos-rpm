From bd3216fbcf9ae7fc39c2174eaa7d6fdf46c06a4f Mon Sep 17 00:00:00 2001
From: HanGao <rabenda.cn@gmail.com>
Date: Fri, 14 Feb 2025 18:26:32 +0800
Subject: [PATCH 405/481] iommu: eswin: sync remove internal arguments from
 of_property_for_each_u32

Signed-off-by: HanGao <rabenda.cn@gmail.com>
---
 drivers/iommu/eswin/eswin-win2030-sid.c | 8 ++------
 1 file changed, 2 insertions(+), 6 deletions(-)

diff --git a/drivers/iommu/eswin/eswin-win2030-sid.c b/drivers/iommu/eswin/eswin-win2030-sid.c
index 7a4d5fe5002e..e3308e4e35ee 100644
--- a/drivers/iommu/eswin/eswin-win2030-sid.c
+++ b/drivers/iommu/eswin/eswin-win2030-sid.c
@@ -873,8 +873,6 @@ int win2030_tbu_power(struct device *dev, bool is_powerUp)
 	u32 tbu_id;
 	const struct win2030_tbu_client *tbu_client_p = NULL;
 	struct tbu_priv *tbu_priv_p;
-	struct property *prop;
-	const __be32 *cur;
 	int tbu_num = 0;
 
 	if (nid == NUMA_NO_NODE) {
@@ -888,7 +886,7 @@ int win2030_tbu_power(struct device *dev, bool is_powerUp)
 	}
 
 	dev_info(dev, "%s %s!\n", __func__, (is_powerUp == true)? "up":"down");
-	of_property_for_each_u32(node, "tbus", prop, cur, tbu_id) {
+	of_property_for_each_u32(node, "tbus", tbu_id) {
 		pr_debug("tbus = <0x%02x>\n", tbu_id);
 		if (0 == win2030_get_tbu_priv(nid, tbu_id, &tbu_priv_p)) {
 			tbu_client_p = tbu_priv_p->tbu_client_p;
@@ -929,8 +927,6 @@ int win2030_tbu_power_by_dev_and_node(struct device *dev, struct device_node *no
 	u32 tbu_id;
 	const struct win2030_tbu_client *tbu_client_p = NULL;
 	struct tbu_priv *tbu_priv_p;
-	struct property *prop;
-	const __be32 *cur;
 	int tbu_num = 0;
 
 	if (nid == NUMA_NO_NODE) {
@@ -944,7 +940,7 @@ int win2030_tbu_power_by_dev_and_node(struct device *dev, struct device_node *no
 	}
 
 	pr_debug("%s called!\n", __func__);
-	of_property_for_each_u32(node, "tbus", prop, cur, tbu_id) {
+	of_property_for_each_u32(node, "tbus", tbu_id) {
 		pr_debug("tbus = <0x%02x>\n", tbu_id);
 		if (0 == win2030_get_tbu_priv(nid, tbu_id, &tbu_priv_p)) {
 			tbu_client_p = tbu_priv_p->tbu_client_p;
-- 
2.49.0

