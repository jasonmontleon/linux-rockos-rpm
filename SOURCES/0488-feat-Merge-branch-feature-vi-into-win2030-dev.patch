+#!/bin/sh
+
+param_mss="false"
+param_videoin="false"
+
+if [ -n "$1" ];then
+    if [ "$1" = "mss" ];then
+        param_mss="true"
+    elif [ "$1" = "vi" ];then
+        param_videoin="true"
+    fi
+fi
+
+if [ -n "$2" ];then
+    if [ "$2" = "mss" ];then
+        param_mss="true"
+    elif [ "$2" = "vi" ];then
+        param_videoin="true"
+    fi
+fi
+
+rmmod ./i2c/vvcam_i2c.ko
+rmmod ./mipi/vvcam_mipi.ko
+rmmod ./isp/vvcam_isp.ko
+rmmod ./vb/vvcam_vb.ko
+
+# remove mi_subsystem driver.
+if [ "$param_mss" = "true" ];then
+    rmmod ./mi_subsystem/vvcam_mss.ko
+fi
+
+# remove video in driver.
+if [ "$param_videoin" = "true" ];then
+    rmmod ./videoin/vvcam_vi.ko
+fi
diff --git a/drivers/media/platform/eswin/isp/vvcam/soc/Makefile b/drivers/media/platform/eswin/isp/vvcam/soc/Makefile
new file mode 100644
index 000000000000..2a96e7d42173
--- /dev/null
+++ b/drivers/media/platform/eswin/isp/vvcam/soc/Makefile
@@ -0,0 +1,29 @@
+ifeq ($(VVCAM_PATH),)
+	VVCAM_PATH:=$(shell cd $(shell pwd)/../; pwd)
+	export VVCAM_PATH
+endif
+
+
+include $(PWD)/../Param.mk
+TARGET = vvcam_soc
+
+obj-m +=$(TARGET).o
+$(TARGET)-objs += vvcam_soc_driver.o
+$(TARGET)-objs += soc_ioctl.o
+$(TARGET)-objs += vivsoc_hub.o
+$(TARGET)-objs += vsi_core_gen6.o
+$(TARGET)-objs += vivsoc_dvp2axi.o
+
+PWD :=$(shell pwd)
+
+all:
+	make -C $(KERNEL_DIR) M=$(PWD) modules
+	@[ -e $(INSTALL_DIR)/lib ] || mkdir $(INSTALL_DIR)/lib -p
+	@cp $(TARGET).ko $(INSTALL_DIR)/lib
+modules_install:
+	make -C $(KERNEL_DIR) M=$(PWD) modules_install
+clean:
+	rm -rf $($(TARGET)-objs)
+	make -C $(KERNEL_DIR) M=$(PWD) clean
+	@rm $(INSTALL_DIR)/lib/$(TARGET).ko
+
