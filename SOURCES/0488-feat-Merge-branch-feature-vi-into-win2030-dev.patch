+insmod ./isp/vvcam_isp.ko devices_mask=${devices_mask} rdc_enable=${rdc_enable}
+
+if [ "$param_videoin" = "true" ];then
+    insmod ./videoin/vvcam_vi.ko
+fi
+
+if [ "$param_mss" = "true" ];then
+    insmod ./mi_subsystem/vvcam_mss.ko
+fi
