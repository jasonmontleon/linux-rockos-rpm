+int vvcam_isp_exp_v3_ctrl_count(void)
+{
+    return ARRAY_SIZE(vvcam_isp_exp_v3_ctrls);
+}
+
+int vvcam_isp_exp_v3_ctrl_create(struct vvcam_isp_dev *isp_dev)
+{
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(vvcam_isp_exp_v3_ctrls); i++) {
