+        .step = 1,
+        .min  = 10,
+        .max  = 1280,
+        .def  = 10,
+    },
+    {
+        /* float 17x array 0.0 ~ 4095.0 */
+        .ops  = &vvcam_isp_dpf_ctrl_ops,
+        .id   = VVCAM_ISP_CID_DPF_MANU_NOISE_CURVE,
+        .type = V4L2_CTRL_TYPE_U32,
