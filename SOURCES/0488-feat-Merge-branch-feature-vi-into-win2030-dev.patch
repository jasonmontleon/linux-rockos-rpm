+     __u16 gainmap[ESMODULE_PADF_GAINMAP_LEN];
+     __u16 dccmap[ESMODULE_PDAF_DCCMAP_LEN];
+ } __attribute__ ((packed));
+ 
+ /**
+  * struct esmodule_otp_module_inf - otp module info
+  *
+  */
+ struct esmodule_otp_module_inf {
+     __u32 flag;
