+	pr_info("%s: vi_dvp2axi_int0 0x%x, vi_dvp2axi_int1 0x%x, vi_dvp2axi_int_err 0x%x\n", __func__, vi_dvp2axi_int0, vi_dvp2axi_int1, vi_dvp2axi_int_err);
