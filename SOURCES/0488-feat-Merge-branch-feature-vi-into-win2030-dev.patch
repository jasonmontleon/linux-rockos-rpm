+	.vidioc_querycap = es_dvp2axi_querycap,
+	.vidioc_s_selection = es_dvp2axi_s_selection,
+	.vidioc_g_selection = es_dvp2axi_g_selection,
+	.vidioc_enum_frameintervals = es_dvp2axi_enum_frameintervals,
