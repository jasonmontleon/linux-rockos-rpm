+                            &vvcam_isp_af_ctrls[i], NULL);
+        if (isp_dev->ctrl_handler.error) {
+            dev_err( isp_dev->dev, "reigster isp af ctrl %s failed %d.\n",
+                vvcam_isp_af_ctrls[i].name, isp_dev->ctrl_handler.error);
+        }
+    }
+
+    return 0;
+
+}
