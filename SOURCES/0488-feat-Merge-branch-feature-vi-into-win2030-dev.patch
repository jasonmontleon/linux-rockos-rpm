+struct platform_driver es_dvp2axi_subdev_driver = {
+	.probe = es_dvp2axi_subdev_probe,
+	.remove = es_dvp2axi_subdev_remove,
+	.driver = {
+		.name = "es_dvp2axi_sditf",
+		.of_match_table = es_dvp2axi_subdev_match_id,
+	},
+};
