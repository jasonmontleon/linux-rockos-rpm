+#define VVCAM_ISP_EVENT_ELEMS 10
+#define VVCAM_VI_EVENT_ELEMS 10
+struct vvcam_isp_dev {
+    phys_addr_t paddr;
+    uint32_t regs_size;
+    void __iomem *base;
+    void __iomem *reset;
+    int  id;
+    int isp_irq;
+    int fe_irq;
+    int mi_irq;
+    int fusa_irq;
