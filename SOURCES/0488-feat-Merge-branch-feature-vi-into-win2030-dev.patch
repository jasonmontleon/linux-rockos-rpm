+	struct es_dvp2axi_buffer		*next_buf;
+	struct es_dvp2axi_buffer		*last_buf;
+	struct es_dvp2axi_rx_buffer		*curr_buf_toisp;
+	struct es_dvp2axi_rx_buffer		*next_buf_toisp;
