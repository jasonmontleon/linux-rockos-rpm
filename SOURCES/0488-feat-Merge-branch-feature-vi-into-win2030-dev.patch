+const struct dvp2axi_output_fmt *es_dvp2axi_find_output_fmt(struct es_dvp2axi_stream *stream,
+						   u32 pixelfmt)
+{
+	const struct dvp2axi_output_fmt *fmt;
+	u32 i;
+
+	DPRINTK("t2 %s, %s, %d \n", __FILE__, __func__, __LINE__);
+	DPRINTK("***** t2 pixelfmt =0x%x *****\n", pixelfmt);
+	for (i = 0; i < ARRAY_SIZE(out_fmts); i++) {
+		fmt = &out_fmts[i];
+		if (fmt->fourcc == pixelfmt)
+			return fmt;
+	}
+
+	return NULL;
+}
