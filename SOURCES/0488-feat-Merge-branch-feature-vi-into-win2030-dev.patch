+        case VVCAM_ISP_CID_DPCC_MANU_RND_THRESHOLD:
+        case VVCAM_ISP_CID_DPCC_MANU_RO_LIMITS:
+            ret = vvcam_isp_s_ctrl_event(isp_dev, isp_dev->ctrl_pad, ctrl);
