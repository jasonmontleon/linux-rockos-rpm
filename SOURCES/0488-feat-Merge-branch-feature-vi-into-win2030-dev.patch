+static void imx327_reset_colorspace(struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->colorspace = V4L2_COLORSPACE_SRGB;
+	fmt->ycbcr_enc = V4L2_MAP_YCBCR_ENC_DEFAULT(fmt->colorspace);
+	fmt->quantization = V4L2_MAP_QUANTIZATION_DEFAULT(true, fmt->colorspace,
+							  fmt->ycbcr_enc);
+	fmt->xfer_func = V4L2_MAP_XFER_FUNC_DEFAULT(fmt->colorspace);
+}
+
+static void imx327_update_pad_format(struct imx327 *imx327,
+				     const struct imx327_mode *mode,
+				     struct v4l2_subdev_format *fmt)
+{
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.field = V4L2_FIELD_NONE;
+	imx327_reset_colorspace(&fmt->format);
+}
+static int imx327_get_fmt(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *sd_state,
+			  struct v4l2_subdev_format *fmt)
+{
+	struct imx327 *imx327 = to_imx327(sd);
+	const struct imx327_mode *mode = imx327->cur_mode;
+
+	mutex_lock(&imx327->mutex);
+	/*
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+#ifdef CONFIG_VIDEO_V4L2_SUBDEV_API
+		fmt->format = *v4l2_subdev_get_try_format(sd, sd_state, fmt->pad);
+#else
+		mutex_unlock(&imx327->mutex);
+		return -ENOTTY;
+#endif
+	} else {
+		fmt->format.width = mode->width;
+		fmt->format.height = mode->height;
+		fmt->format.code = mode->bus_fmt;
+		fmt->format.field = V4L2_FIELD_NONE;
+	}
+	*/
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		struct v4l2_mbus_framefmt *try_fmt = v4l2_subdev_get_try_format(
+			&imx327->subdev, sd_state, fmt->pad);
+		/* update the code which could change due to vflip or hflip: */
+		try_fmt->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+		fmt->format = *try_fmt;
+	} else {
+		imx327_update_pad_format(imx327, imx327->cur_mode, fmt);
+		fmt->format.code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	}
+	mutex_unlock(&imx327->mutex);
+	return 0;
+}
