+        .type = V4L2_CTRL_TYPE_U32,
+        .flags= V4L2_CTRL_FLAG_VOLATILE | V4L2_CTRL_FLAG_EXECUTE_ON_WRITE,
+        .name = "isp_dpf_stat_noise_curve",
+        .step = 1,
+        .min  = 0,
+        .max  = 0xFFFFFFFF,
+        .dims = {17, 0, 0, 0},
+    },
+};
+
+int vvcam_isp_dpf_ctrl_count(void)
+{
+    return ARRAY_SIZE(vvcam_isp_dpf_ctrls);
+}
+
+int vvcam_isp_dpf_ctrl_create(struct vvcam_isp_dev *isp_dev)
+{
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(vvcam_isp_dpf_ctrls); i++) {
+        v4l2_ctrl_new_custom(&isp_dev->ctrl_handler,
+                            &vvcam_isp_dpf_ctrls[i], NULL);
+        if (isp_dev->ctrl_handler.error) {
+            dev_err( isp_dev->dev, "reigster isp dpf ctrl %s failed %d.\n",
+                vvcam_isp_dpf_ctrls[i].name, isp_dev->ctrl_handler.error);
+        }
+    }
+
+    return 0;
+
+}
