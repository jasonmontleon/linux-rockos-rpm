+ int imx327_runtime_resume(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx327 *imx327 = to_imx327(sd);
+
+	return __imx327_power_on(imx327);
+}
