+static void release_cmd_list(struct list_head *cmd_list)
+{
+    struct rw_cmd *cmd = NULL, *old = NULL;
+
+    if (!list_empty( cmd_list)) {
+        list_for_each_entry(cmd, cmd_list, list) {
+            if (old) {
+                list_del(&old->list);
+                kfree(old);
+                old = NULL;
+            }
+            if (cmd->rw_buffer)
+                kfree(cmd->rw_buffer);
+            old = cmd;
+        }
+
+        if (old) {
+            list_del(&old->list);
+            kfree(old);
+            old = NULL;
+        }
+    }
+}
