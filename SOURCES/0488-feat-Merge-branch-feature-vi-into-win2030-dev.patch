+/* Write registers up to 4 at a time */
+static int imx327_write_reg(struct i2c_client *client, u16 reg,
+			    u32 len, u32 val)
+{
+	// printk("********** imx327_write_reg ***********\n");
+	// printk("W: reg=0x%x,    val=0x%x\n", reg, val);
+	u32 buf_i, val_i;
+	u8 buf[6];
+	u8 *val_p;
+	__be32 val_be;
+	if (len > 4)
+		return -EINVAL;
+
+	buf[0] = reg >> 8;
+	buf[1] = reg & 0xff;
+
+	val_be = cpu_to_be32(val);
+	val_p = (u8 *)&val_be;
+	buf_i = 2;
+	val_i = 4 - len;
+
+	while (val_i < 4)
+		buf[buf_i++] = val_p[val_i++];
+
+	if (i2c_master_send(client, buf, len + 2) != len + 2)
+		return -EIO;
+	udelay(1000);////add
+	return 0;
+}
