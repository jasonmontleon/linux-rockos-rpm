+#include <linux/module.h>
+#include <linux/version.h>
+#include <linux/platform_device.h>
+
+#include "vvcam_vi_platform.h"
+
+static int devices_mask = 0x01;
+MODULE_PARM_DESC(devices_mask, "vvcam videoin devices mask");
+
+static void vvcam_vi_pdev_release(struct device *dev)
+{
+    dev_info(dev, "%s\n", __func__);
+    return;
+}
+
+static struct resource vvcam_vi1_resource[] = {
+    [0] = {
+        .start = VVCAM_VI1_BASE,
+        .end   = VVCAM_VI1_BASE + VVCAM_VI_REG_SIZE - 1,
+        .flags = IORESOURCE_MEM,
+    },
+    [1] = {
+        .start = VVCAM_VI1_IRQ,
+        .end   = VVCAM_VI1_IRQ,
+        .flags = IORESOURCE_IRQ,
+    },
+};
+
+static struct platform_device vvcam_vi1_pdev = {
+    .name          = "vvcam-vi",
+    .id            = 1,
+    .resource      = vvcam_vi1_resource,
+    .num_resources = ARRAY_SIZE(vvcam_vi1_resource),
+    .dev.release   = vvcam_vi_pdev_release,
+};
+
+static struct resource vvcam_vi0_resource[] = {
+    [0] = {
+        .start = VVCAM_VI0_BASE + PCIE_BASE,
+        .end   = VVCAM_VI0_BASE + PCIE_BASE + VVCAM_VI_REG_SIZE - 1,
+        .flags = IORESOURCE_MEM,
+    },
+    [1] = {
+        .start = VVCAM_VI0_IRQ,
+        .end   = VVCAM_VI0_IRQ,
+        .flags = IORESOURCE_IRQ,
+    },
+};
+
+static struct platform_device vvcam_vi0_pdev = {
+    .name          = "vvcam-vi",
+    .id            = 0,
+    .resource      = vvcam_vi0_resource,
+    .num_resources = ARRAY_SIZE(vvcam_vi0_resource),
+    .dev.release   = vvcam_vi_pdev_release,
+};
+
+int vvcam_vi_platform_device_register(void)
+{
+    int ret = 0;
+    int devs_mask = 0;
+
+    if (devices_mask & 0x01) {
+
+        ret = platform_device_register(&vvcam_vi0_pdev);
+        if (ret) {
+            goto err_register;
+        }
+        devs_mask |= 0x01;
+    }
+    if (devices_mask & 0x02) {
+        ret = platform_device_register(&vvcam_vi1_pdev);
+        if (ret) {
+            goto err_register;
+        }
+        devs_mask |= 0x02;
+    }
+    return ret;
+
+err_register:
+    if (devs_mask & 0x01)
+        platform_device_unregister(&vvcam_vi0_pdev);
+    if (devs_mask & 0x02)
+        platform_device_unregister(&vvcam_vi1_pdev);
+    return ret;
+}
+
+void vvcam_vi_platform_device_unregister(void)
+{
+    if (devices_mask & 0x01)
+        platform_device_unregister(&vvcam_vi0_pdev);
+    if (devices_mask & 0x02)
+        platform_device_unregister(&vvcam_vi1_pdev);
+    return;
+}
+module_param(devices_mask, int, 0644);
