+        case VVCAM_ISP_CID_WB_GR_GAIN:
+        case VVCAM_ISP_CID_WB_GB_GAIN:
+        case VVCAM_ISP_CID_WB_B_GAIN:
+        case VVCAM_ISP_CID_WB_STAT_R_GAIN:
+        case VVCAM_ISP_CID_WB_STAT_GR_GAIN:
+        case VVCAM_ISP_CID_WB_STAT_GB_GAIN:
+        case VVCAM_ISP_CID_WB_STAT_B_GAIN:
+            ret = vvcam_isp_g_ctrl_event(isp_dev, isp_dev->ctrl_pad, ctrl);
+            break;
+
+        default:
+            dev_err(isp_dev->dev, "unknow v4l2 ctrl id %d\n", ctrl->id);
+            return -EACCES;
+    }
+
+    return ret;
+}
