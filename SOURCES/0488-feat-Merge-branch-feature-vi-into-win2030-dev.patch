+}
+
+static ssize_t es_dvp2axi_store_scale_ch1_blc(struct device *dev,
+					 struct device_attribute *attr,
+					 const char *buf, size_t len)
+{
+	struct es_dvp2axi_device *dvp2axi_dev =
+		(struct es_dvp2axi_device *)dev_get_drvdata(dev);
+	int i = 0, index = 0;
