+        case VVCAM_ISP_CID_AWB_USE_MANU_DAMP_COEFF:
+        case VVCAM_ISP_CID_AWB_MANU_DAMP_COEFF:
+        case VVCAM_ISP_CID_AWB_PERFORMANCE_OPTI_MODE:
+        case VVCAM_ISP_CID_AWB_LOCK_THRESH:
+        case VVCAM_ISP_CID_AWB_UNLOCK_THRESH:
+        case VVCAM_ISP_CID_AWB_CONFOUND_CUSTOM_ENABLE:
+        case VVCAM_ISP_CID_AWB_CONFOUND_CUSTOM_POST_EN:
+        case VVCAM_ISP_CID_AWB_CONFOUND_CUSTOM_RG:
+        case VVCAM_ISP_CID_AWB_CONFOUND_CUSTOM_BG:
+        case VVCAM_ISP_CID_AWB_CONFOUND_CUSTOM_THRESH:
+        case VVCAM_ISP_CID_AWB_CONFOUND_CUSTOM_WEIGHT:
+        case VVCAM_ISP_CID_AWB_RESULT_CCT:
+            ret = vvcam_isp_g_ctrl_event(isp_dev, isp_dev->ctrl_pad, ctrl);
+            break;
+
+        default:
+            dev_err(isp_dev->dev, "unknow v4l2 ctrl id %d\n", ctrl->id);
+            return -EACCES;
+    }
+
+    return ret;
+}
