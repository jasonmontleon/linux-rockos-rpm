+{
+    int ret;
+    switch (sub->type) {
+	case V4L2_EVENT_CTRL:
+		ret = v4l2_ctrl_subscribe_event(fh, sub);
+        break;
+    case VVCAM_VIDEO_DEAMON_EVENT:
+        ret = v4l2_event_subscribe(fh, sub, 2, NULL);
+        break;
+	default:
+		ret = -EINVAL;
+        break;
+	}
+    return ret;
+}
