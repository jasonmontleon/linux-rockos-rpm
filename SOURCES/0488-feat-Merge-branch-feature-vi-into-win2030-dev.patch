+};
+
+#ifdef __KERNEL__
+
+struct vvcam_soc_dev {
+	void __iomem *base;
+	void __iomem *scu_base;
+	struct soc_control_context isp0;
+	struct soc_control_context isp1;
+	struct soc_control_context dwe;
+	struct soc_control_context vse;
