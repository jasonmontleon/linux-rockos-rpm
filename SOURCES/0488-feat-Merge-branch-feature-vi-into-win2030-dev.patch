+
+		dvp2axi_dev->scale_vdev[1].blc.pattern00 = val[0];
+		dvp2axi_dev->scale_vdev[1].blc.pattern01 = val[1];
+		dvp2axi_dev->scale_vdev[1].blc.pattern02 = val[2];
