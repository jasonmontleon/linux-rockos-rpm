+        case VVCAM_ISP_CID_HDR_DEGHOST_LSVS_DARK_UPPER_THR:
+        case VVCAM_ISP_CID_HDR_DPF_L_GAIN:
+        case VVCAM_ISP_CID_HDR_DPF_L_GRADIENT:
+        case VVCAM_ISP_CID_HDR_DPF_L_OFFSET:
+        case VVCAM_ISP_CID_HDR_DPF_L_MIN:
+        case VVCAM_ISP_CID_HDR_DPF_L_DIV:
+        case VVCAM_ISP_CID_HDR_DPF_L_SIGMA_G:
+        case VVCAM_ISP_CID_HDR_DPF_L_SIGMA_RB:
