+static int vvcam_isp_3dnr_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+    int ret = 0;
+    struct vvcam_isp_dev *isp_dev =
+        container_of(ctrl->handler, struct vvcam_isp_dev, ctrl_handler);
+
+    switch (ctrl->id)
+    {
+        case VVCAM_ISP_CID_3DNR_ENABLE:
+        case VVCAM_ISP_CID_3DNR_MOTION_DILATE_ENABLE:
+        case VVCAM_ISP_CID_3DNR_RESET:
+        case VVCAM_ISP_CID_3DNR_MODE:
+        case VVCAM_ISP_CID_3DNR_AUTO_LEVEL:
+        case VVCAM_ISP_CID_3DNR_AUTO_GAIN:
+        case VVCAM_ISP_CID_3DNR_AUTO_STRENGTH:
+        case VVCAM_ISP_CID_3DNR_AUTO_MOTION_INV:
+        case VVCAM_ISP_CID_3DNR_AUTO_DELTA:
+        case VVCAM_ISP_CID_3DNR_AUTO_TEMP_MOTION_DILATE_ENABLE:
+        case VVCAM_ISP_CID_3DNR_AUTO_TEMP_UPDATE:
+        case VVCAM_ISP_CID_3DNR_AUTO_TEMP_STRENGTH_CURVE:
+        case VVCAM_ISP_CID_3DNR_AUTO_TEMP_CURVE:
+        case VVCAM_ISP_CID_3DNR_AUTO_TEMP_RANGE_T:
+        case VVCAM_ISP_CID_3DNR_MANU_STRENGTH:
+        case VVCAM_ISP_CID_3DNR_MANU_MOTION_INV:
+        case VVCAM_ISP_CID_3DNR_MANU_DELTA:
+        case VVCAM_ISP_CID_3DNR_MANU_TEMP_UPDATE:
+        case VVCAM_ISP_CID_3DNR_MANU_TEMP_STRENGTH_CURVE:
+        case VVCAM_ISP_CID_3DNR_MANU_TEMP_CURVE:
+        case VVCAM_ISP_CID_3DNR_MANU_TEMP_RANGE_T:
+        case VVCAM_ISP_CID_3DNR_GAMMA_FEBE_NOISE_EN:
+        case VVCAM_ISP_CID_3DNR_GAMMA_FEBE_INPUT_BIT:
+        case VVCAM_ISP_CID_3DNR_GAMMA_FEBE_FIX_CURVE_START:
+        case VVCAM_ISP_CID_3DNR_GAMMA_FEBE_BLS_EXP:
+            ret = vvcam_isp_s_ctrl_event(isp_dev, isp_dev->ctrl_pad, ctrl);
+            break;
+
+        default:
+            dev_err(isp_dev->dev, "unknow v4l2 ctrl id %d\n", ctrl->id);
+            return -EACCES;
+    }
+
+    return ret;
+}
