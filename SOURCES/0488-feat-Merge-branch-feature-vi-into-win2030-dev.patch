+        case VVCAM_ISP_CID_CNR_STAT_STRENGTH2:
+        case VVCAM_ISP_CID_CNR_STAT_TEXTURE_MASK:
+            ret = vvcam_isp_g_ctrl_event(isp_dev, isp_dev->ctrl_pad, ctrl);
+            break;
+
+        default:
+            dev_err(isp_dev->dev, "unknow v4l2 ctrl id %d\n", ctrl->id);
+            return -EACCES;
+    }
+
+    return ret;
+}
