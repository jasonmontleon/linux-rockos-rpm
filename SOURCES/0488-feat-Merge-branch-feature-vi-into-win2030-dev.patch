+#include <linux/platform_device.h>
+
+#include "vvcam_mipi_platform.h"
+
+static int devices_mask = 0x01;
+MODULE_PARM_DESC(devices_mask, "vvcam mipi devices mask");
+
+static void vvcam_mipi_pdev_release(struct device *dev)
+{
+    dev_info(dev, "%s\n", __func__);
+	return;
+}
+
+static struct resource vvcam_mipi0_resource[] = {
+	[0] = {
+        .start = VVCAM_CSI0_BASE + PCIE_BASE,
+        .end   = VVCAM_CSI0_BASE + PCIE_BASE + VVCAM_CSI_REG_SIZE - 1,
+        .flags = IORESOURCE_MEM,
+    },
+	[1] = {
+        .start = VVCAM_TPG0 + PCIE_BASE,
+        .end   = VVCAM_TPG0 + PCIE_BASE + VVCAM_TPG_SIZE - 1,
+        .flags = IORESOURCE_MEM,
+    },
+
+	[2] = {
+#if CSI_CTRL_MUX_T0T1
+        .start = VVCAM_CSI1_CTRL + PCIE_BASE,
+        .end   = VVCAM_CSI1_CTRL + PCIE_BASE + VVCAM_CSI_CTRL_SIZE - 1,
+#else
+        .start = VVCAM_CSI0_CTRL + PCIE_BASE,
+        .end   = VVCAM_CSI0_CTRL + PCIE_BASE + VVCAM_CSI_CTRL_SIZE - 1,
+#endif
+        .flags = IORESOURCE_MEM,
+    },
+    [3] = {
+        .start = VVCAM_CSI0_MUX_CTRL + PCIE_BASE,
+        .end   = VVCAM_CSI0_MUX_CTRL + PCIE_BASE + VVCAM_CSI_MUX_CTRL_SIZE - 1,
+        .flags = IORESOURCE_MEM,
+    },
+};
+
+static struct platform_device vvcam_mipi0_pdev = {
+	.name          = "vvcam-mipi",
+	.id            = 0,
+	.resource      = vvcam_mipi0_resource,
+    .num_resources = ARRAY_SIZE(vvcam_mipi0_resource),
+	.dev.release   = vvcam_mipi_pdev_release,
+};
+
+static struct resource vvcam_mipi1_resource[] = {
+	[0] = {
+        .start = VVCAM_CSI1_BASE + PCIE_BASE,
+        .end   = VVCAM_CSI1_BASE + PCIE_BASE + VVCAM_CSI_REG_SIZE - 1,
+        .flags = IORESOURCE_MEM,
+    },
+	[1] = {
+        .start = VVCAM_TPG1 + PCIE_BASE,
+        .end   = VVCAM_TPG1 + PCIE_BASE + VVCAM_TPG_SIZE - 1,
+        .flags = IORESOURCE_MEM,
+    },
+	[2] = {
+#if CSI_CTRL_MUX_T0T1
+        .start = VVCAM_CSI0_CTRL + PCIE_BASE,
+        .end   = VVCAM_CSI0_CTRL + PCIE_BASE + VVCAM_CSI_CTRL_SIZE - 1,
+#else
+        .start = VVCAM_CSI1_CTRL + PCIE_BASE,
+        .end   = VVCAM_CSI1_CTRL + PCIE_BASE + VVCAM_CSI_CTRL_SIZE - 1,
+#endif
+        .flags = IORESOURCE_MEM,
+    },
+    [3] = {
+        .start = VVCAM_CSI1_MUX_CTRL + PCIE_BASE,
+        .end   = VVCAM_CSI1_MUX_CTRL + PCIE_BASE + VVCAM_CSI_MUX_CTRL_SIZE - 1,
+        .flags = IORESOURCE_MEM,
+    },
+};
+
+static struct platform_device vvcam_mipi1_pdev = {
+	.name          = "vvcam-mipi",
+	.id            = 1,
+	.resource      = vvcam_mipi1_resource,
+    .num_resources = ARRAY_SIZE(vvcam_mipi1_resource),
+	.dev.release   = vvcam_mipi_pdev_release,
+};
+
+static struct resource vvcam_mipi2_resource[] = {
+	[0] = {
+        .start = VVCAM_CSI2_BASE + PCIE_BASE,
+        .end   = VVCAM_CSI2_BASE + PCIE_BASE + VVCAM_CSI_REG_SIZE - 1,
+        .flags = IORESOURCE_MEM,
+    },
+	[1] = {
+        .start = VVCAM_TPG2 + PCIE_BASE,
+        .end   = VVCAM_TPG2 + PCIE_BASE + VVCAM_TPG_SIZE - 1,
+        .flags = IORESOURCE_MEM,
+    },
+	[2] = {
+#if CSI_CTRL_MUX_T2T3
+        .start = VVCAM_CSI3_CTRL + PCIE_BASE,
+        .end   = VVCAM_CSI3_CTRL + PCIE_BASE + VVCAM_CSI_CTRL_SIZE - 1,
+#else
+        .start = VVCAM_CSI2_CTRL + PCIE_BASE,
+        .end   = VVCAM_CSI2_CTRL + PCIE_BASE + VVCAM_CSI_CTRL_SIZE - 1,
+#endif
+        .flags = IORESOURCE_MEM,
+    },
+    [3] = {
+        .start = VVCAM_CSI2_MUX_CTRL + PCIE_BASE,
+        .end   = VVCAM_CSI2_MUX_CTRL + PCIE_BASE + VVCAM_CSI_MUX_CTRL_SIZE - 1,
+        .flags = IORESOURCE_MEM,
+    },
+};
+
+static struct platform_device vvcam_mipi2_pdev = {
+	.name          = "vvcam-mipi",
+	.id            = 2,
+	.resource      = vvcam_mipi2_resource,
+    .num_resources = ARRAY_SIZE(vvcam_mipi2_resource),
+	.dev.release   = vvcam_mipi_pdev_release,
+};
+
+static struct resource vvcam_mipi3_resource[] = {
+	[0] = {
+        .start = VVCAM_CSI3_BASE + PCIE_BASE,
+        .end   = VVCAM_CSI3_BASE + PCIE_BASE + VVCAM_CSI_REG_SIZE - 1,
+        .flags = IORESOURCE_MEM,
+    },
+	[1] = {
+        .start = VVCAM_TPG3+ PCIE_BASE,
+        .end   = VVCAM_TPG3 + PCIE_BASE + VVCAM_TPG_SIZE - 1,
+        .flags = IORESOURCE_MEM,
+    },
+	[2] = {
+#if CSI_CTRL_MUX_T2T3
+        .start = VVCAM_CSI2_CTRL + PCIE_BASE,
+        .end   = VVCAM_CSI2_CTRL + PCIE_BASE + VVCAM_CSI_CTRL_SIZE - 1,
+#else
+        .start = VVCAM_CSI3_CTRL + PCIE_BASE,
+        .end   = VVCAM_CSI3_CTRL + PCIE_BASE + VVCAM_CSI_CTRL_SIZE - 1,
+#endif
+        .flags = IORESOURCE_MEM,
+    },
+    [3] = {
+        .start = VVCAM_CSI3_MUX_CTRL + PCIE_BASE,
+        .end   = VVCAM_CSI3_MUX_CTRL + PCIE_BASE + VVCAM_CSI_MUX_CTRL_SIZE - 1,
+        .flags = IORESOURCE_MEM,
+    },
+};
+
+static struct platform_device vvcam_mipi3_pdev = {
+	.name          = "vvcam-mipi",
+	.id            = 3,
+	.resource      = vvcam_mipi3_resource,
+    .num_resources = ARRAY_SIZE(vvcam_mipi3_resource),
+	.dev.release   = vvcam_mipi_pdev_release,
+};
+
+int vvcam_mipi_platform_device_register(void)
+{
+    int ret = 0;
+    int devs_mask = 0;
+    if (devices_mask & 0x01) {
+        ret = platform_device_register(&vvcam_mipi0_pdev);
+        if (ret) {
+            goto err_register;
+        }
+        devs_mask |= 0x01;
+    }
+
+    if (devices_mask & 0x02) {
+        ret = platform_device_register(&vvcam_mipi1_pdev);
+        if (ret) {
+            goto err_register;
+        }
+        devs_mask |= 0x02;
+    }
+
+    if (devices_mask & 0x04) {
+        ret = platform_device_register(&vvcam_mipi2_pdev);
+        if (ret) {
+            goto err_register;
+        }
+        devs_mask |= 0x04;
+    }
+
+    if (devices_mask & 0x08) {
+        ret = platform_device_register(&vvcam_mipi3_pdev);
+        if (ret) {
+            goto err_register;
+        }
+        devs_mask |= 0x08;
+    }
+
+    return ret;
+
+err_register:
+    if (devs_mask & 0x01)
+		platform_device_unregister(&vvcam_mipi0_pdev);
+	if (devs_mask & 0x02)
+		platform_device_unregister(&vvcam_mipi1_pdev);
+	if (devs_mask & 0x04)
+		platform_device_unregister(&vvcam_mipi2_pdev);
+	if (devs_mask & 0x08)
+		platform_device_unregister(&vvcam_mipi3_pdev);
+
+    return ret;
+}
+
+void vvcam_mipi_platform_device_unregister(void)
+{
+    if (devices_mask & 0x01)
+		platform_device_unregister(&vvcam_mipi0_pdev);
+	if (devices_mask & 0x02)
+		platform_device_unregister(&vvcam_mipi1_pdev);
+	if (devices_mask & 0x04)
+		platform_device_unregister(&vvcam_mipi2_pdev);
+	if (devices_mask & 0x08)
+		platform_device_unregister(&vvcam_mipi3_pdev);
+
+    return;
+}
+
+module_param(devices_mask, int, 0644);
