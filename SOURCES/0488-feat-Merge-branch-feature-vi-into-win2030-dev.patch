+static int imx327_init_conversion_gain(struct imx327 *imx327)
+{
+	int ret = 0;
+	struct i2c_client *client = imx327->client;
+	u32 val = 0;
+
+	ret = imx327_read_reg(client,
+		IMX327_GAIN_SWITCH_REG,
+		IMX327_REG_VALUE_08BIT,
+		&val);
