+#endif
+
+#define CHECK_COPY_RETVAL(retval) do { \
+	if (retval < 0) { \
+		pr_err("%s %d: copy from or to user failed\n", __func__, __LINE__); \
+		return -EFAULT; \
+	} \
+} while(0);
