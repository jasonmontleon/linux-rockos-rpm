+        .id   = VVCAM_ISP_CID_AFM_FIR_LOW_PASS_WEIGHT,
+        .type = V4L2_CTRL_TYPE_INTEGER,
+        .flags= V4L2_CTRL_FLAG_VOLATILE | V4L2_CTRL_FLAG_EXECUTE_ON_WRITE,
+        .name = "isp_afm_fir_low_pass_weight",
