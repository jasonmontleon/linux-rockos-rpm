+        .id   = VVCAM_ISP_CID_HDR_RATIO,
+        .type = V4L2_CTRL_TYPE_U32,
+        .flags= V4L2_CTRL_FLAG_VOLATILE | V4L2_CTRL_FLAG_EXECUTE_ON_WRITE,
+        .name = "isp_hdr_ratio",
+        .step = 1,
+        .min  = 0,
+        .max  = 0xFFFFFFFF,
+        .dims = {2, 0, 0, 0},
+    },
+    {
