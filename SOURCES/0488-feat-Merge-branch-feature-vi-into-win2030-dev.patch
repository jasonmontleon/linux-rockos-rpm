+int vvcam_isp_hdr_ctrl_create(struct vvcam_isp_dev *isp_dev)
+{
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(vvcam_isp_hdr_ctrls); i++) {
+        v4l2_ctrl_new_custom(&isp_dev->ctrl_handler,
+                            &vvcam_isp_hdr_ctrls[i], NULL);
