+
+#include "dw-mipi-csi.h"
+
+#define DEBUG
+#define VERBOSE_DEBUG
+
+static struct R_CSI2 reg = {
+	.VERSION = 0x00,
+	.N_LANES = 0x04,
+	.CTRL_RESETN = 0x08,
+	.INTERRUPT = 0x0C,
+	.DATA_IDS_1 = 0x10,
