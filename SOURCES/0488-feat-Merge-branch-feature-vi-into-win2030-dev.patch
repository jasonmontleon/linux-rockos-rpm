+        .flags= V4L2_CTRL_FLAG_VOLATILE | V4L2_CTRL_FLAG_EXECUTE_ON_WRITE,
+        .name = "isp_rgbir_reset",
+        .step = 1,
+        .min  = 0,
+        .max  = 1,
+    },
+    {
+        /* float array 12x (-4,4)*/
+        .ops  = &vvcam_isp_rgbir_ctrl_ops,
+        .id   = VVCAM_ISP_CID_RGBIR_CC_MATRIX,
+        .type = V4L2_CTRL_TYPE_U32,
+        .flags= V4L2_CTRL_FLAG_VOLATILE | V4L2_CTRL_FLAG_EXECUTE_ON_WRITE,
+        .name = "isp_rgbir_cc_matrix",
+        .step = 1,
+        .min  = 0,
+        .max  = 0xFFFFFFFF,
+        .dims = {12, 0, 0, 0},
+    },
+    {
+        .ops  = &vvcam_isp_rgbir_ctrl_ops,
