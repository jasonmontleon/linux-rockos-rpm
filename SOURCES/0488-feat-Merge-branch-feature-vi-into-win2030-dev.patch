+#define VI_FUSA_LV1_MIS1  0x2190
+#define VI_FUSA_ECC_MIS1  0x21a4
+#define VI_FUSA_PARITY_MIS1  0x21b8
+#define VI_FUSA_PARITY_MIS2  0x21cc
+#define VI_FUSA_ADAP_PIX_LOSS_MIS1  0x21e0
+#define VI_FUSA_RDC_PIX_LOSS_MIS1  0x21f8
+#define VI_FUSA_RDC_TPG_BIST_MIS1  0x2210
+#define VI_FUSA_RDC_TPG_BIST_MIS2  0x2224
+
+#define VI_FUSA_LV1_ICR1  0x2198
+#define VI_FUSA_ECC_ICR1  0x21ac
+#define VI_FUSA_PARITY_ICR1  0x21c0
+#define VI_FUSA_PARITY_ICR2  0x21d4
+#define VI_FUSA_ADAP_PIX_LOSS_ICR1  0x21e8
+#define VI_FUSA_RDC_PIX_LOSS_ICR1  0x2200
+#define VI_FUSA_RDC_TPG_BIST_ICR1  0x2218
+#define VI_FUSA_RDC_TPG_BIST_ICR2  0x222c
+
+#define  MCM0_MI_MIS2  0x1224
+#define  MCM1_MI_MIS2  0x1624
+#define  MCM2_MI_MIS2  0x1a24
+#define  MCM3_MI_MIS2  0x1e24
+
+#define  MCM0_MI_ICR2  0x122c
+#define  MCM1_MI_ICR2  0x162c
+#define  MCM2_MI_ICR2  0x1a2c
+#define  MCM3_MI_ICR2  0x1e2c
+
+#define  ADAPT0_MIS   0x0134
+#define  ADAPT1_MIS   0x0534
+#define  ADAPT2_MIS   0x0934
+#define  ADAPT3_MIS   0x0D34
+
+#define  ADAPT0_ICR   0x012C
+#define  ADAPT1_ICR   0x052C
+#define  ADAPT2_ICR   0x092C
+#define  ADAPT3_ICR   0x0D2C
+
+#define  CH0_XS_FRAME_END_MASK  (1U << 31)
+#define  CH0_VS_FRAME_END_MASK  (1U << 30)
+#define  CH0_S_FRAME_END_MASK   (1U << 29)
+#define  CH0_L_FRAME_END_MASK   (1U << 28)
+#define  CH1_XS_FRAME_END_MASK  (1U << 27)
+#define  CH1_VS_FRAME_END_MASK  (1U << 26)
+#define  CH1_S_FRAME_END_MASK   (1U << 25)
+#define  CH1_L_FRAME_END_MASK   (1U << 24)
+#define  CH2_XS_FRAME_END_MASK  (1U << 23)
+#define  CH2_VS_FRAME_END_MASK  (1U << 22)
+#define  CH2_S_FRAME_END_MASK   (1U << 21)
+#define  CH2_L_FRAME_END_MASK   (1U << 20)
+#define  CH3_XS_FRAME_END_MASK  (1U << 19)
+#define  CH3_VS_FRAME_END_MASK  (1U << 18)
+#define  CH3_S_FRAME_END_MASK   (1U << 17)
+#define  CH3_L_FRAME_END_MASK   (1U << 16)
+
+#endif
