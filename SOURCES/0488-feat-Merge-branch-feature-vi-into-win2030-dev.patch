+        case VVCAM_ISP_CID_AFM_INST1_WIN_B_SHARPNESS:
+        case VVCAM_ISP_CID_AFM_INST1_WIN_C_SHARPNESS:
+        case VVCAM_ISP_CID_AFM_INST1_WIN_A_LUMINANCE:
+        case VVCAM_ISP_CID_AFM_INST1_WIN_B_LUMINANCE:
