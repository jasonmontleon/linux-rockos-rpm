+        .id   = VVCAM_ISP_CID_CPROC_RESET,
+        .type = V4L2_CTRL_TYPE_BOOLEAN,
+        .flags= V4L2_CTRL_FLAG_VOLATILE | V4L2_CTRL_FLAG_EXECUTE_ON_WRITE,
+        .name = "isp_cproc_reset",
