+	.probe = eswin_csi2_dphy_hw_probe,
+	.remove = eswin_csi2_dphy_hw_remove,
+	.driver = {
+		.name = "eswin-csi2-dphy-hw",
+		.owner = THIS_MODULE,
+		.of_match_table = eswin_csi2_dphy_hw_match_id,
+	},
+};
