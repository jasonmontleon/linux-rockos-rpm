+static ssize_t es_dvp2axi_show_memory_mode(struct device *dev,
+				      struct device_attribute *attr, char *buf)
+{
+	struct es_dvp2axi_device *dvp2axi_dev =
+		(struct es_dvp2axi_device *)dev_get_drvdata(dev);
+	int ret;
