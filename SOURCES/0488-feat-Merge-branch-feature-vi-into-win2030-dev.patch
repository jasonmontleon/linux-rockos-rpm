+};
+
+#define MBUS_CSI2_MAX_DATA_LANES		8
+
+struct mbus_config_mipi_csi2 {
+	unsigned int flags;
+	unsigned char data_lanes[MBUS_CSI2_MAX_DATA_LANES];
+	unsigned char clock_lane;
+	unsigned char num_data_lanes;
+	bool lane_polarities[1 + MBUS_CSI2_MAX_DATA_LANES];
+};
+
+enum mbus_type {
+    MBUS_UNKNOWN,
+	MBUS_PARALLEL,
+	MBUS_BT656,
+	MBUS_CSI1,
+	MBUS_CCP2,
+	MBUS_CSI2_DPHY,
+	MBUS_CSI2_CPHY,
+    MBUS_DPI,
+	MBUS_INVALID,
+};
+
+typedef struct {
+    enum mbus_type type;
