+static int vvcam_isp_open(struct v4l2_subdev *sd, struct v4l2_subdev_fh *fh)
+{
+	struct vvcam_isp_dev *isp_dev = v4l2_get_subdevdata(sd);
+
+	mutex_lock(&isp_dev->mlock);
+	isp_dev->refcnt++;
+	pm_runtime_get_sync(sd->dev);
+
+	mutex_unlock(&isp_dev->mlock);
+	return 0;
+}
