+        .min  = 0,
+        .max  = 63,
+        .dims = {1, 0, 0, 0},
+    },
+    {
+        .ops  = &vvcam_isp_exp_ctrl_ops,
+        .id   = VVCAM_ISP_CID_EXP_GR_WEIGHT,
+        .type = V4L2_CTRL_TYPE_U8,
