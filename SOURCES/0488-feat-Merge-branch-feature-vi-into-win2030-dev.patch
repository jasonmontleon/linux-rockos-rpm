+#define DVP2AXI_PCLK_DELAY_ENABLE		(0x02000200)
+#define DVP2AXI_PCLK_DELAY_DISABLE		(0x02000000)
+#define DVP2AXI_SAMPLING_EDGE_DOUBLE	(0x01000100)
+#define DVP2AXI_SAMPLING_EDGE_SINGLE	(0x01000000)
+#define DVP2AXI_PCLK_DELAY_NUM(num)		(0x00ff0000 | ((num) & 0xff))
+#define DVP2AXI_GRF_VI_CON0			(0x340)
+#define DVP2AXI_GRF_VI_CON1			(0x344)
+#define DVP2AXI_GRF_SOC_CON2			(0x308)
+#define EIC770X_DVP2AXI_PCLK_SAMPLING_EDGE_RISING	(0x00100000)
+#define EIC770X_DVP2AXI_PCLK_SAMPLING_EDGE_FALLING	(0x00100010)
+#define EIC770X_DVP2AXI_PCLK_SINGLE_EDGE		(0x00200000)
+#define EIC770X_DVP2AXI_PCLK_DUAL_EDGE		(0x00200020)
+
+/*toisp*/
+#define TOISP_FS_CH0(index)		(0x1 << (14 + index * 3))
+#define TOISP_FS_CH1(index)		(0x1 << (15 + index * 3))
+#define TOISP_FS_CH2(index)		(0x1 << (16 + index * 3))
+
+#define TOISP_END_CH0(index)		(0x1 << (20 + index * 3))
+#define TOISP_END_CH1(index)		(0x1 << (21 + index * 3))
+#define TOISP_END_CH2(index)		(0x1 << (22 + index * 3))
+
+#endif
