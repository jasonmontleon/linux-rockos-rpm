+static int es_dvp2axi_scale_enum_input(struct file *file, void *priv,
+				  struct v4l2_input *input)
+{
+
+	if (input->index > 0)
+		return -EINVAL;
+
+	input->type = V4L2_INPUT_TYPE_CAMERA;
+	strscpy(input->name, "Camera", sizeof(input->name));
+
+	return 0;
+}
