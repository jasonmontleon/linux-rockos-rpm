+        case VVCAM_ISP_CID_HDR_DPF_S_DIV:
+        case VVCAM_ISP_CID_HDR_DPF_S_SIGMA_G:
+        case VVCAM_ISP_CID_HDR_DPF_S_SIGMA_RB:
+        case VVCAM_ISP_CID_HDR_DPF_S_NOISE_CURVE:
+        case VVCAM_ISP_CID_HDR_DPF_VS_GAIN:
+        case VVCAM_ISP_CID_HDR_DPF_VS_GRADIENT:
+        case VVCAM_ISP_CID_HDR_DPF_VS_OFFSET:
+        case VVCAM_ISP_CID_HDR_DPF_VS_MIN:
+        case VVCAM_ISP_CID_HDR_DPF_VS_DIV:
+        case VVCAM_ISP_CID_HDR_DPF_VS_SIGMA_G:
+        case VVCAM_ISP_CID_HDR_DPF_VS_SIGMA_RB:
+        case VVCAM_ISP_CID_HDR_DPF_VS_NOISE_CURVE:
+            ret = vvcam_isp_s_ctrl_event(isp_dev, isp_dev->ctrl_pad, ctrl);
+            break;
+
+        default:
+            dev_err(isp_dev->dev, "unknow v4l2 ctrl id %d\n", ctrl->id);
+            return -EACCES;
+    }
+
+    return ret;
+}
