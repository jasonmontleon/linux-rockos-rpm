+ #define ES_DVP2AXI_CMD_SET_CSI_MEMORY_MODE \
+     _IOW('V', BASE_VIDIOC_PRIVATE + 1, int)
+ 
+ #define ES_DVP2AXI_CMD_GET_SCALE_BLC \
+     _IOR('V', BASE_VIDIOC_PRIVATE + 2, struct bayer_blc)
+ 
+ #define ES_DVP2AXI_CMD_SET_SCALE_BLC \
