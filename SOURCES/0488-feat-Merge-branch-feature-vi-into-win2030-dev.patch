+static void es_dvp2axi_toisp_set_stream(struct es_dvp2axi_device *dev, int on)
+{
+	struct v4l2_subdev *sd = get_esisp_sd(dev->sditf[0]);
+
+	if (sd)
+		v4l2_subdev_call(sd, core, ioctl, ESISP_VICAP_CMD_SET_STREAM,
+				 &on);
+}
