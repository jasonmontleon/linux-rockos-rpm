+        if (isp_dev->ctrl_handler.error) {
+            dev_err( isp_dev->dev, "reigster isp 3dnr ctrl %s failed %d.\n",
+                vvcam_isp_3dnr_ctrls[i].name, isp_dev->ctrl_handler.error);
+        }
+    }
+
+    return 0;
+
+}
