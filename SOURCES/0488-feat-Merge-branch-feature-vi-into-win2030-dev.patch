+        .id   = VVCAM_ISP_CID_DPF_STAT_MIN,
+        .type = V4L2_CTRL_TYPE_INTEGER,
+        .flags= V4L2_CTRL_FLAG_VOLATILE | V4L2_CTRL_FLAG_EXECUTE_ON_WRITE,
+        .name = "isp_dpf_stat_min",
+        .step = 1,
+        .min  = 10,
+        .max  = 1280,
+        .def  = 10,
+    },
+    {
+        /* float 1.0 ~ 64.0 */
+        .ops  = &vvcam_isp_dpf_ctrl_ops,
+        .id   = VVCAM_ISP_CID_DPF_STAT_DIV,
+        .type = V4L2_CTRL_TYPE_INTEGER,
+        .flags= V4L2_CTRL_FLAG_VOLATILE | V4L2_CTRL_FLAG_EXECUTE_ON_WRITE,
+        .name = "isp_dpf_stat_div",
+        .step = 1,
+        .min  = 10,
+        .max  = 650,
+        .def  = 10,
