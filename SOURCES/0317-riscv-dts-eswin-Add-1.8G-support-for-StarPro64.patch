From 83cac28c22e8165eccffc1977a68f0f3084e2d74 Mon Sep 17 00:00:00 2001
From: Icenowy Zheng <uwu@icenowy.me>
Date: Sun, 5 Jan 2025 23:47:58 +0800
Subject: [PATCH 317/481] riscv: dts: eswin: Add 1.8G support for StarPro64

Signed-off-by: Icenowy Zheng <uwu@icenowy.me>
---
 arch/riscv/boot/dts/eswin/eic7700-pine64-starpro64.dts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/riscv/boot/dts/eswin/eic7700-pine64-starpro64.dts b/arch/riscv/boot/dts/eswin/eic7700-pine64-starpro64.dts
index b7a599878685..fdcd551ef5c5 100644
--- a/arch/riscv/boot/dts/eswin/eic7700-pine64-starpro64.dts
+++ b/arch/riscv/boot/dts/eswin/eic7700-pine64-starpro64.dts
@@ -127,6 +127,7 @@ status {
 
 &d0_clock {
 	status = "okay";
+	force-1_8ghz;
 };
 
 &d0_reset {
@@ -791,4 +792,9 @@ opp-1600000000 {
 		opp-microvolt = <900000>;
 		clock-latency-ns = <70000>;
 	};
+	opp-1800000000 {
+		opp-hz = /bits/ 64 <CLK_FREQ_1800M>;
+		opp-microvolt = <900000>;
+		clock-latency-ns = <70000>;
+	};
 };
-- 
2.49.0

