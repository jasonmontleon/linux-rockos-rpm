From 7f5035b041492543ed66ad26c7ad04243edf4590 Mon Sep 17 00:00:00 2001
From: zouxiaojun <zouxiaojun@eswincomputing.com>
Date: Mon, 31 Mar 2025 17:39:31 +0800
Subject: [PATCH 451/652] fix(vc):opt error log for redup interrupts

Changelogs:
opt error log for reduplicative interrupts.

Signed-off-by: zouxiaojun <zouxiaojun@eswincomputing.com>
---
 drivers/staging/media/eswin/vdec/hantro_vcmd.c        | 2 +-
 drivers/staging/media/eswin/venc/vc8000_vcmd_driver.c | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/staging/media/eswin/vdec/hantro_vcmd.c b/drivers/staging/media/eswin/vdec/hantro_vcmd.c
index 6d6cb6dcb1ea1..3ccbc0da1a95e 100644
--- a/drivers/staging/media/eswin/vdec/hantro_vcmd.c
+++ b/drivers/staging/media/eswin/vdec/hantro_vcmd.c
@@ -4936,7 +4936,7 @@ static irqreturn_t hantrovcmd_isr(int irq, void *dev_id)
 		}
 		new_cmdbuf_node = global_cmdbuf_node[cmdbuf_id];
 		if (!new_cmdbuf_node) {
-			LOG_ERR("ERROR cmdbuf_id line=%d, cmdbuf_id=%u!!\n", __LINE__, cmdbuf_id);
+			LOG_INFO("task has been done, but vdec interrupt occurred, cmdbuf_id line=%d, cmdbuf_id=%u!!\n", __LINE__, cmdbuf_id);
 			spin_unlock_irqrestore(dev->spinlock, flags);
 			return IRQ_HANDLED;
 		}
diff --git a/drivers/staging/media/eswin/venc/vc8000_vcmd_driver.c b/drivers/staging/media/eswin/venc/vc8000_vcmd_driver.c
index 0686cc8dbd04d..39829260fa5d9 100644
--- a/drivers/staging/media/eswin/venc/vc8000_vcmd_driver.c
+++ b/drivers/staging/media/eswin/venc/vc8000_vcmd_driver.c
@@ -4505,7 +4505,7 @@ static irqreturn_t hantrovcmd_isr(int irq, void *dev_id)
 		}
 		new_cmdbuf_node = global_cmdbuf_node[cmdbuf_id];
 		if (!new_cmdbuf_node) {
-			LOG_ERR("vcmd_isr error cmdbuf_id %d!!\n", cmdbuf_id);
+			LOG_INFO("task has been done, but vdec interrupt occurred, cmdbuf_id line=%d, cmdbuf_id=%u!!\n", __LINE__, cmdbuf_id);
 			spin_unlock_irqrestore(dev->spinlock, flags);
 			return IRQ_HANDLED;
 		}
-- 
2.53.0

