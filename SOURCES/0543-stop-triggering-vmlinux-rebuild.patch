+
+struct dev_buffer_desc {
+	struct dma_buf *buf;
+	u32 offset;
+	u32 len;
+};
+
+enum es_malloc_policy {
+	ES_MEM_ALLOC_RSV,
+	ES_MEM_ALLOC_NORMAL,
+	ES_MEM_ALLOC_NORMAL_COHERENT,
+	ES_MEM_ALLOC_CMA,
+	ES_MEM_ALLOC_CMA_COHERENT,
+	ES_MEM_ALLOC_CMA_LLC,
