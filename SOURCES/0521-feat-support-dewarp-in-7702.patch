+++ b/arch/riscv/configs/eic7702_defconfig
@@ -862,3 +862,5 @@ CONFIG_REGULATOR_FIXED_VOLTAGE=y
 CONFIG_BCMDHD_FW_PATH="/lib/firmware/fw_bcm43456c5_ag.bin"
 CONFIG_BCMDHD_NVRAM_PATH="/lib/firmware/nvram_ap6256.txt"
 CONFIG_BCMDHD_CLM_PATH="/lib/firmware/clm_bcm43752a2_ag.blob"
+CONFIG_VIDEO_ESWIN_VI_TOP=y
+CONFIG_VIDEO_ESWIN_DVP2AXI=y
