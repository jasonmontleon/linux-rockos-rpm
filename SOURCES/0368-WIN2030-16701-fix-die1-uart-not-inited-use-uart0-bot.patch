Change-Id: Idcd61cbfb0f65d580925fef955205ade99f75e4b
Signed-off-by: luoshanggui <luoshanggui@eswincomputing.com>
---
 arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi b/arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi
