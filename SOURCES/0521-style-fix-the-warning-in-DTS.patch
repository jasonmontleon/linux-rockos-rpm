+++ b/arch/riscv/boot/dts/eswin/eswin-win2030-arch-d2d.dtsi
@@ -108,6 +108,7 @@ cpu_4: cpu@4 {
 		numa-node-id = <1>;
 		clocks = <&d1_clock EIC7700_CLK_CPU_EXT_SRC_CORE_CLK_0>;
 		operating-points-v2 = <&d1_cpu_opp_table>;
+		#cooling-cells = <2>;
 		cpu-idle-states = <&CPU_RET>;
 		cpu4_intc: interrupt-controller {
 			#interrupt-cells = <1>;
@@ -156,6 +157,7 @@ cpu_5: cpu@5 {
 		numa-node-id = <1>;
 		clocks = <&d1_clock EIC7700_CLK_CPU_EXT_SRC_CORE_CLK_1>;
 		operating-points-v2 = <&d1_cpu_opp_table>;
+		#cooling-cells = <2>;
