 		cpu5_intc: interrupt-controller {
 			#interrupt-cells = <1>;
@@ -203,6 +205,7 @@ cpu_6: cpu@6 {
 		numa-node-id = <1>;
 		clocks = <&d1_clock EIC7700_CLK_CPU_EXT_SRC_CORE_CLK_2>;
 		operating-points-v2 = <&d1_cpu_opp_table>;
+		#cooling-cells = <2>;
 		cpu-idle-states = <&CPU_RET>;
 		cpu6_intc: interrupt-controller {
 			#interrupt-cells = <1>;
@@ -250,6 +253,7 @@ cpu_7: cpu@7 {
 		numa-node-id = <1>;
 		clocks = <&d1_clock EIC7700_CLK_CPU_EXT_SRC_CORE_CLK_3>;
 		operating-points-v2 = <&d1_cpu_opp_table>;
+		#cooling-cells = <2>;
 		cpu-idle-states = <&CPU_RET>;
 		cpu7_intc: interrupt-controller {
 			#interrupt-cells = <1>;
