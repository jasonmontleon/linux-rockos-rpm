From 273990df88fcbfb83f1362af3403810d4da46a1b Mon Sep 17 00:00:00 2001
From: luoxianke <luoxianke@eswincomputing.com>
Date: Wed, 28 May 2025 14:29:45 +0800
Subject: [PATCH 528/652] fix:solve guvcview print err log

Changelogs: delete nouse log

Signed-off-by: luoxianke <luoxianke@eswincomputing.com>
---
 .../platform/eswin/isp/vvcam/v4l2/video/vvcam_video_event.c      | 1 -
 .../platform/eswin/isp/vvcam/v4l2/video/vvcam_video_register.c   | 1 -
 2 files changed, 2 deletions(-)

diff --git a/drivers/media/platform/eswin/isp/vvcam/v4l2/video/vvcam_video_event.c b/drivers/media/platform/eswin/isp/vvcam/v4l2/video/vvcam_video_event.c
index 372ed7b783ca5..85f137f4176a5 100644
--- a/drivers/media/platform/eswin/isp/vvcam/v4l2/video/vvcam_video_event.c
+++ b/drivers/media/platform/eswin/isp/vvcam/v4l2/video/vvcam_video_event.c
@@ -100,7 +100,6 @@ int vvcam_video_post_event(struct vvcam_video_dev *vvcam_vdev,
     memcpy(event.u.data, &event_pkg->head, sizeof(event_pkg->head));
 
     if (!vvcam_video_event_subscribed(vvcam_vdev, event.type, event.id)) {
-        printk("vvcam_video_event_subscribed failed\n");
         return -EINVAL;
     }
 
diff --git a/drivers/media/platform/eswin/isp/vvcam/v4l2/video/vvcam_video_register.c b/drivers/media/platform/eswin/isp/vvcam/v4l2/video/vvcam_video_register.c
index e3a7160eb1c3d..d926dc00e8a4a 100644
--- a/drivers/media/platform/eswin/isp/vvcam/v4l2/video/vvcam_video_register.c
+++ b/drivers/media/platform/eswin/isp/vvcam/v4l2/video/vvcam_video_register.c
@@ -1237,7 +1237,6 @@ static int vvcam_video_try_create_pipeline(struct vvcam_video_dev *vvcam_vdev)
 
     ret = vvcam_video_create_pipeline_event(vvcam_vdev);
     if (ret) {
-        printk("vvcam video creat pipeline event failed ret = %d\n", ret);
         return ret;
     }
 
