From 357c15bbe1383b46a566c2980a2fd0509810a28e Mon Sep 17 00:00:00 2001
From: carbon <carbon@milkv.io>
Date: Thu, 2 Jan 2025 18:46:26 +0800
Subject: [PATCH 315/652] milkv-megrez: fix sd card delay_code

Signed-off-by: carbon <carbon@milkv.io>
---
 arch/riscv/boot/dts/eswin/eic7700-milkv-megrez.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7700-milkv-megrez.dts b/arch/riscv/boot/dts/eswin/eic7700-milkv-megrez.dts
index 1a77bb521dc8..43c00efd35de 100644
--- a/arch/riscv/boot/dts/eswin/eic7700-milkv-megrez.dts
+++ b/arch/riscv/boot/dts/eswin/eic7700-milkv-megrez.dts
@@ -450,7 +450,7 @@ &sdhci_emmc {
 &sdio0 {
 	/* sd card */
 	status = "okay";
-	delay_code = <0x55>;
+	delay_code = <0x3b>;
 	drive-impedance-ohm = <33>;
 	enable-cmd-pullup;
 	enable-data-pullup;
-- 
2.53.0

