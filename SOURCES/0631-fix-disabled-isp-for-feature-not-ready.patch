From ea7a1d92baa0a1a239f98b38df0f65ff0b3359cd Mon Sep 17 00:00:00 2001
From: shenzhenya <shenzhenya@eswincomputing.com>
Date: Tue, 15 Jul 2025 14:20:57 +0800
Subject: [PATCH 631/652] fix: disabled isp for feature not ready

Changelogs:
1. disabled isp for feature not ready

Signed-off-by: shenzhenya <shenzhenya@eswincomputing.com>
---
 arch/riscv/boot/dts/eswin/eic7702-d560-die0-camera.dtsi | 8 ++++----
 arch/riscv/boot/dts/eswin/eic7702-d560-die1-camera.dtsi | 8 ++++----
 2 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-d560-die0-camera.dtsi b/arch/riscv/boot/dts/eswin/eic7702-d560-die0-camera.dtsi
index 8609a01c11c1..aa903a98238e 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-d560-die0-camera.dtsi
+++ b/arch/riscv/boot/dts/eswin/eic7702-d560-die0-camera.dtsi
@@ -5,7 +5,7 @@ &vi_subsys {
     vvcam_isp_0: vvcam_isp@0 {
         compatible = "verisilicon,isp-v4l2";
         id = <0>;
-        status = "okay";
+        status = "disabled";
 		dma-noncoherent;
 
         ports {
@@ -53,7 +53,7 @@ vvcam_isp_port0_raw: endpoint {
 
 	vvcam_vb: vvcam-vb@0 {
 		compatible = "verisilicon,vb";
-		status = "okay";
+		status = "disabled";
 		dma-noncoherent;
 		dma-ranges = <0x0 0x20000000 0x0 0x80000000 0x0 0x40000000>;
 		iommus = <&smmu0 WIN2030_SID_ISP0>;
@@ -62,7 +62,7 @@ vvcam_vb: vvcam-vb@0 {
     vvcam_video_0: vvcam_video@0 {
         compatible = "verisilicon,video";
         id = <0>;
-        status = "okay";
+        status = "disabled";
 		dma-noncoherent;
 		dma-ranges = <0x0 0x20000000 0x0 0x80000000 0x0 0x40000000>;
 		iommus = <&smmu0 WIN2030_SID_ISP0>;
@@ -345,7 +345,7 @@ axi2dvp_mipi2_in2: endpoint@0 {
 
 
 &isp_0 {
-	status = "okay";
+	status = "disabled";
 };
 
 &isp_1 {
diff --git a/arch/riscv/boot/dts/eswin/eic7702-d560-die1-camera.dtsi b/arch/riscv/boot/dts/eswin/eic7702-d560-die1-camera.dtsi
index 366d7f52b4a0..6fefc408236c 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-d560-die1-camera.dtsi
+++ b/arch/riscv/boot/dts/eswin/eic7702-d560-die1-camera.dtsi
@@ -5,7 +5,7 @@ &d1_vi_subsys {
     d1_vvcam_isp_0: d1-vvcam_isp@0 {
         compatible = "verisilicon,isp-v4l2";
         id = <0>;
-        status = "okay";
+        status = "disabled";
 		dma-noncoherent;
 
         ports {
@@ -53,7 +53,7 @@ d1_vvcam_isp_port0_raw: endpoint {
 
 	d1_vvcam_vb: d1-vvcam-vb@0 {
 		compatible = "verisilicon,vb";
-		status = "okay";
+		status = "disabled";
 		dma-noncoherent;
 		dma-ranges = <0x0 0x20000000 0x0 0x80000000 0x0 0x40000000>;
 		iommus = <&smmu1 WIN2030_SID_ISP0>;
@@ -62,7 +62,7 @@ d1_vvcam_vb: d1-vvcam-vb@0 {
     d1_vvcam_video_0: d1-vvcam_video@0 {
         compatible = "verisilicon,video";
         id = <0>;
-        status = "okay";
+        status = "disabled";
 		dma-noncoherent;
 		dma-ranges = <0x0 0x20000000 0x0 0x80000000 0x0 0x40000000>;
 		iommus = <&smmu1 WIN2030_SID_ISP0>;
@@ -345,7 +345,7 @@ d1_axi2dvp_mipi2_in2: endpoint@0 {
 
 
 &d1_isp_0 {
-	status = "okay";
+	status = "disabled";
 };
 
 &d1_isp_1 {
-- 
2.53.0

