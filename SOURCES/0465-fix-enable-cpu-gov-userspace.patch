From 5baca25b049162890917f6421fb18ad4f84ea200 Mon Sep 17 00:00:00 2001
From: yangwei1 <yangwei1@eswincomputing.com>
Date: Tue, 8 Apr 2025 16:30:11 +0800
Subject: [PATCH 465/654] fix:enable cpu gov userspace

Changelogs:

Signed-off-by: yangwei1 <yangwei1@eswincomputing.com>
---
 arch/riscv/boot/dts/eswin/eswin-win2030-die0-soc.dtsi | 2 +-
 arch/riscv/configs/eic7700_defconfig                  | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/riscv/boot/dts/eswin/eswin-win2030-die0-soc.dtsi b/arch/riscv/boot/dts/eswin/eswin-win2030-die0-soc.dtsi
index 1d365fa5fe09..946693b00b4d 100644
--- a/arch/riscv/boot/dts/eswin/eswin-win2030-die0-soc.dtsi
+++ b/arch/riscv/boot/dts/eswin/eswin-win2030-die0-soc.dtsi
@@ -53,7 +53,7 @@ target: trip-point1 {
 				};
 				
 				crit: trip-point2 {
-					temperature     = <110000>;
+					temperature     = <105000>;
 					hysteresis      = <0>;
 					type            = "critical";
 				};
diff --git a/arch/riscv/configs/eic7700_defconfig b/arch/riscv/configs/eic7700_defconfig
index fdbb24bf7834..9cefc6922209 100644
--- a/arch/riscv/configs/eic7700_defconfig
+++ b/arch/riscv/configs/eic7700_defconfig
@@ -44,6 +44,7 @@ CONFIG_CPU_FREQ_STAT=y
 CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
 CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
 CONFIG_CPU_FREQ_GOV_POWERSAVE=y
+CONFIG_CPU_FREQ_GOV_USERSPACE=y
 CONFIG_CPU_FREQ_GOV_ONDEMAND=y
 CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
 CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
