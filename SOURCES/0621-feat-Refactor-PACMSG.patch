 CONFIG_MESSAGE_LOGLEVEL_DEFAULT=7
diff --git a/arch/riscv/configs/vpu7702_pcie_a2_defconfig b/arch/riscv/configs/vpu7702_pcie_a2_defconfig
index 0ebdbaeda9df..781a13eb6f3d 100644
