+++ b/lib/Kconfig.debug
@@ -35,20 +35,6 @@ config PRINTK_CALLER
 	  no option to enable/disable at the kernel command line parameter or
 	  sysfs interface.
 
-config PRINTK_TO_SHMEM
-	bool "Reserve printk output to shared memory"
-	depends on PRINTK
-	help
-	  Selecting this option causes printk() messages to be written
-	  to a shared memory region, in addition to the standard output
-	  (console, syslog, etc.).
-
-	  This feature is useful for real-time logging or debugging
-	  scenarios where low-latency access to kernel logs is required.
-
-	  The shared memory region can be accessed by user-space
-	  applications or other kernel modules.
-
 config STACKTRACE_BUILD_ID
 	bool "Show build ID information in stacktraces"
 	depends on PRINTK
