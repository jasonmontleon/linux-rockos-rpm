From 2afef6767c20cd4bcc94b13fed6c580a8253fac1 Mon Sep 17 00:00:00 2001
From: ningyu <ningyu@eswincomputing.com>
Date: Wed, 2 Jul 2025 17:38:30 +0800
Subject: [PATCH 599/652] fix:disable wifi by default

Changelogs:

Signed-off-by: ningyu <ningyu@eswincomputing.com>
---
 arch/riscv/boot/dts/eswin/eic7700-sbc-a1.dts | 76 ++++++++++++++++++++
 1 file changed, 76 insertions(+)

diff --git a/arch/riscv/boot/dts/eswin/eic7700-sbc-a1.dts b/arch/riscv/boot/dts/eswin/eic7700-sbc-a1.dts
index 36366cc3642eb..04ffef051e20f 100644
--- a/arch/riscv/boot/dts/eswin/eic7700-sbc-a1.dts
+++ b/arch/riscv/boot/dts/eswin/eic7700-sbc-a1.dts
@@ -19,3 +19,79 @@
  */
 
 #include "eic7700-sbc-a1.dtsi"
+
+
+&video_output {
+	status = "okay";
+};
+
+&dc {
+	status = "okay";
+	dc_out: port {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		dc_out_dpi: endpoint@0 {
+			reg = <0>;
+			remote-endpoint = <&vd_input>;
+		};
+		dc_out_hdmi: endpoint@1 {
+			reg = <1>;
+			remote-endpoint = <&hdmi_in_dc>;
+		};
+	};
+};
+
+&dw_hdmi {
+        status = "okay";
+        ports {
+                #address-cells = <1>;
+                #size-cells = <0>;
+                port@0 {
+                        reg = <0>;
+                        hdmi_in_dc: endpoint@0 {
+                                remote-endpoint = <&dc_out_hdmi>;
+                        };
+                };
+                port@2 {
+                        reg = <2>;
+                        hdmi_in_i2s: endpoint@1 {
+                                system-clock-frequency = <12288000>;
+                                remote-endpoint = <&d0_i2s0_endpoint>;
+                        };
+                };
+        };
+};
+
+&d0_i2s0 {
+        status = "okay";
+        d0_i2s0_port: port {
+                d0_i2s0_endpoint: endpoint {
+                        remote-endpoint = <&hdmi_in_i2s>;
+                        dai-format = "i2s";
+                };
+        };
+};
+
+&d0_graphcard0 {
+        status = "okay";
+        label = "HDMI Audio";
+        dais = <&d0_i2s0_port>;
+};
+
+&dsi_output {
+    status = "okay";
+};
+
+&dsi_controller {
+	status = "okay";
+};
+
+&d0_i2c2 {
+	/* touch screen*/
+	status = "okay";
+};
+
+&sdio1 {
+        /* disable this port */
+        status = "disabled";
+};
\ No newline at end of file
-- 
