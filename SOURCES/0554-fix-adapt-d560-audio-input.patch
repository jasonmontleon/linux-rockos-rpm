Subject: [PATCH 554/652] fix:adapt d560 audio input

Changelogs:
1. adapt d560 audio input

Signed-off-by: yiguo <yiguo@eswincomputing.com>
---
 arch/riscv/boot/dts/eswin/eic7702-d560.dts | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-d560.dts b/arch/riscv/boot/dts/eswin/eic7702-d560.dts
index 29c7fbc030fe8..a31f359283ed7 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-d560.dts
+++ b/arch/riscv/boot/dts/eswin/eic7702-d560.dts
@@ -148,6 +148,11 @@ d0_es8388_0: es8388-0@11 {
 		compatible = "eswin,es8388";
 		reg = <0x11>;
 		#sound-dai-cells = <0>;
+		eswin-plat = <2>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_die0_gpio25_default &pinctrl_die0_gpio26_default>;
+		front-jack-gpios = <&porta 25 GPIO_ACTIVE_HIGH>;
+		back-jack-gpios = <&porta 26 GPIO_ACTIVE_HIGH>;
 		port {
 			d0_codec0_endpoint: endpoint {
 				system-clock-frequency = <12288000>;
@@ -307,7 +312,7 @@ &pinctrl_die0_gpio47_default &pinctrl_die0_gpio54_default &pinctrl_die0_gpio55_d
 				 &pinctrl_die0_gpio75_default &pinctrl_die0_gpio79_default &pinctrl_die0_gpio81_default &pinctrl_die0_gpio36_default
 				 &pinctrl_die0_gpio37_default &pinctrl_die0_gpio38_default &pinctrl_die0_gpio74_default &pinctrl_die0_gpio92_default
 				 &pinctrl_die0_gpio93_default>;
