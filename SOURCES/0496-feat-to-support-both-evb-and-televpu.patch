From 16a874587328089429efd877a919b059709e8cfb Mon Sep 17 00:00:00 2001
From: zhouliang1 <zhouliang1@eswincomputing.com>
Date: Wed, 30 Apr 2025 19:55:01 +0800
Subject: [PATCH 496/652] feat:to support both evb and televpu

Changelogs:
1. use different files to support both evb and
teletvpu for vpu7702

Signed-off-by: zhouliang1 <zhouliang1@eswincomputing.com>
Reviewed-by: Joey Zheng <zhengyu@eswincomputing.com>
Tested-by: Guichao Zhou <zhouguichao@eswincomputing.com>
---
 arch/riscv/boot/dts/eswin/vpu7702-evb.dts     | 1085 +++++++++++++++++
 arch/riscv/boot/dts/eswin/vpu7702-pcie.dts    | 1032 ++++++++++++++++
 arch/riscv/configs/vpu7702_evb_defconfig      |  850 +++++++++++++
 ...u7702_defconfig => vpu7702_pcie_defconfig} |    0
 4 files changed, 2967 insertions(+)
 create mode 100644 arch/riscv/boot/dts/eswin/vpu7702-evb.dts
 create mode 100644 arch/riscv/boot/dts/eswin/vpu7702-pcie.dts
 create mode 100644 arch/riscv/configs/vpu7702_evb_defconfig
 rename arch/riscv/configs/{eic7700_vpu7702_defconfig => vpu7702_pcie_defconfig} (100%)

diff --git a/arch/riscv/boot/dts/eswin/vpu7702-evb.dts b/arch/riscv/boot/dts/eswin/vpu7702-evb.dts
new file mode 100644
index 000000000000..ef7606e68027
--- /dev/null
+++ b/arch/riscv/boot/dts/eswin/vpu7702-evb.dts
@@ -0,0 +1,1085 @@
