From ff7f2d609f28621f1414bc8731078df259d381d5 Mon Sep 17 00:00:00 2001
From: chenzhanzhan <chenzhanzhan@eswincomputing.com>
Date: Wed, 2 Jul 2025 18:01:39 +0800
Subject: [PATCH 600/652] feature: Support trigger kdump when rcu stall

Changelogs:
1. Support trigger kdump when rcu stall detect

Signed-off-by: chenzhanzhan <chenzhanzhan@eswincomputing.com>
---
 arch/riscv/configs/eic7700_dbg_defconfig | 1 +
 arch/riscv/configs/eic7702_dbg_defconfig | 1 +
 2 files changed, 2 insertions(+)

diff --git a/arch/riscv/configs/eic7700_dbg_defconfig b/arch/riscv/configs/eic7700_dbg_defconfig
index 4db3ce7e6f6fd..dd0d599ed96d6 100644
--- a/arch/riscv/configs/eic7700_dbg_defconfig
+++ b/arch/riscv/configs/eic7700_dbg_defconfig
@@ -846,6 +846,7 @@ CONFIG_DEBUG_ATOMIC_SLEEP=y
 CONFIG_DEBUG_LIST=y
 CONFIG_DEBUG_PLIST=y
 CONFIG_DEBUG_SG=y
+CONFIG_RCU_CPU_STALL_CPUTIME=y
 CONFIG_RCU_EQS_DEBUG=y
 # CONFIG_RUNTIME_TESTING_MENU is not set
 CONFIG_MEMTEST=y
diff --git a/arch/riscv/configs/eic7702_dbg_defconfig b/arch/riscv/configs/eic7702_dbg_defconfig
index 174f6aac9374a..a2bd1daf22bc8 100644
--- a/arch/riscv/configs/eic7702_dbg_defconfig
+++ b/arch/riscv/configs/eic7702_dbg_defconfig
@@ -874,6 +874,7 @@ CONFIG_DEBUG_ATOMIC_SLEEP=y
 CONFIG_DEBUG_LIST=y
 CONFIG_DEBUG_PLIST=y
 CONFIG_DEBUG_SG=y
+CONFIG_RCU_CPU_STALL_CPUTIME=y
 CONFIG_RCU_EQS_DEBUG=y
 # CONFIG_RUNTIME_TESTING_MENU is not set
 CONFIG_MEMTEST=y
-- 
2.51.0

