From 72f4a821d4be3681d0762c96dac8b6b78c45c1e9 Mon Sep 17 00:00:00 2001
From: Icenowy Zheng <uwu@icenowy.me>
Date: Fri, 13 Jun 2025 14:30:55 +0800
Subject: [PATCH 538/654] riscv: configs: enable Motorcomm PHY driver

StarPro64 uses Motorcomm YT8531 PHYs.

Signed-off-by: Icenowy Zheng <uwu@icenowy.me>
---
 arch/riscv/configs/win2030_defconfig | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/riscv/configs/win2030_defconfig b/arch/riscv/configs/win2030_defconfig
index dfe1b886df52..31bc21c2496f 100644
--- a/arch/riscv/configs/win2030_defconfig
+++ b/arch/riscv/configs/win2030_defconfig
@@ -543,6 +543,7 @@ CONFIG_NGBE=m
 CONFIG_TXGBE=m
 # CONFIG_NET_VENDOR_WIZNET is not set
 # CONFIG_NET_VENDOR_XILINX is not set
+CONFIG_MOTORCOMM_PHY=y
 CONFIG_REALTEK_PHY=y
 CONFIG_PPP=m
 CONFIG_PPP_BSDCOMP=m
-- 
2.51.0

