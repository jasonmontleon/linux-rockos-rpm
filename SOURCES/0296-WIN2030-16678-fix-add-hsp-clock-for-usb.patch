From e1f1a3597539c126f821640484b4ebf106bf1ee4 Mon Sep 17 00:00:00 2001
From: yangwei1 <yangwei1@eswincomputing.com>
Date: Wed, 27 Nov 2024 17:06:26 +0800
Subject: [PATCH 296/416] WIN2030-16678:fix:add hsp clock for usb

Changelogs:
	if no this clock,the usb control will not work

Change-Id: I4b9bed3ffab0e08dd87ab12acca74b8cb4245679
Signed-off-by: yangwei1 <yangwei1@eswincomputing.com>
---
 arch/riscv/boot/dts/eswin/eswin-win2030-die0-soc.dtsi | 10 ++++++----
 arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi | 10 ++++++----
 2 files changed, 12 insertions(+), 8 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eswin-win2030-die0-soc.dtsi b/arch/riscv/boot/dts/eswin/eswin-win2030-die0-soc.dtsi
index dd1fedbdbabe..05836a452cce 100644
--- a/arch/riscv/boot/dts/eswin/eswin-win2030-die0-soc.dtsi
+++ b/arch/riscv/boot/dts/eswin/eswin-win2030-die0-soc.dtsi
@@ -1977,8 +1977,9 @@ d0_usbdrd3_0: usb0@50480000 {
 			compatible = "eswin,win2030-dwc3";
 			#address-cells = <2>;
 			#size-cells = <2>;
-			clocks =<&d0_clock WIN2030_GATE_HSP_USB0_SUSPEND_CLK>;
-			clock-names = "suspend";
+			clocks =<&d0_clock WIN2030_GATE_HSP_USB0_SUSPEND_CLK>,
+					<&d0_clock WIN2030_CLK_HSP_CFG_CLK>;
+			clock-names = "suspend","hsp_clk";
 			eswin,hsp_sp_csr = <&d0_hsp_sp_csr 0x800 0x808 0x83c 0x840>;
 			resets = <&d0_reset HSPDMA_RST_CTRL SW_USB0_VAUX_RSTN>;
 			reset-names = "vaux";
@@ -2014,8 +2015,9 @@ d0_usbdrd3_1: usb1@50490000  {
 			compatible = "eswin,win2030-dwc3";
 			#address-cells = <2>;
 			#size-cells = <2>;
-			clocks =<&d0_clock WIN2030_GATE_HSP_USB1_SUSPEND_CLK>;
-			clock-names = "suspend";
+			clocks =<&d0_clock WIN2030_GATE_HSP_USB1_SUSPEND_CLK>,
+					<&d0_clock WIN2030_CLK_HSP_CFG_CLK>;
+			clock-names = "suspend","hsp_clk";
 			eswin,hsp_sp_csr = <&d0_hsp_sp_csr 0x900 0x908 0x93c 0x940>;
 			resets = <&d0_reset HSPDMA_RST_CTRL SW_USB1_VAUX_RSTN>;
 			reset-names = "vaux";
diff --git a/arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi b/arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi
index c05df53e7bf5..75c5e840975c 100644
--- a/arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi
+++ b/arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi
@@ -2042,8 +2042,9 @@ d1_usbdrd3_0: usb0@70480000 {
 			compatible = "eswin,win2030-dwc3";
 			#address-cells = <2>;
 			#size-cells = <2>;
-			clocks =<&d1_clock WIN2030_GATE_HSP_USB0_SUSPEND_CLK>;
-			clock-names = "suspend";
+			clocks =<&d1_clock WIN2030_GATE_HSP_USB0_SUSPEND_CLK>,
+					<&d1_clock WIN2030_CLK_HSP_CFG_CLK>;
+			clock-names = "suspend","hsp_clk";
 			eswin,hsp_sp_csr = <&d1_hsp_sp_csr 0x800 0x808 0x83c 0x840>;
 			resets = <&d1_reset HSPDMA_RST_CTRL SW_USB0_VAUX_RSTN>;
 			reset-names = "vaux";
@@ -2079,8 +2080,9 @@ d1_usbdrd3_1: usb1@70490000 {
 			compatible = "eswin,win2030-dwc3";
 			#address-cells = <2>;
 			#size-cells = <2>;
-			clocks =<&d1_clock WIN2030_GATE_HSP_USB1_SUSPEND_CLK>;
-			clock-names = "suspend";
+			clocks =<&d1_clock WIN2030_GATE_HSP_USB1_SUSPEND_CLK>,
+					<&d1_clock WIN2030_CLK_HSP_CFG_CLK>;
+			clock-names = "suspend","hsp_clk";
 			eswin,hsp_sp_csr = <&d1_hsp_sp_csr 0x900 0x908 0x93c 0x940>;
 			resets = <&d1_reset HSPDMA_RST_CTRL SW_USB1_VAUX_RSTN>;
 			reset-names = "vaux";
-- 
