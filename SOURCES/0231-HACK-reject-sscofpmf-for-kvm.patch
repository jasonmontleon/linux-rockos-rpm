From a026b130370477821aab0f8700c5b9ac99998a8a Mon Sep 17 00:00:00 2001
From: Han Gao <gaohan@iscas.ac.cn>
Date: Mon, 11 Nov 2024 23:30:40 +0800
Subject: [PATCH 231/654] HACK: reject sscofpmf for kvm

cannot start VM properly after enabling
temporary reject probe sscofpmf

Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 arch/riscv/kvm/vcpu_pmu.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/riscv/kvm/vcpu_pmu.c b/arch/riscv/kvm/vcpu_pmu.c
index e2e2a115afb5..0a8ab8c3700f 100644
--- a/arch/riscv/kvm/vcpu_pmu.c
+++ b/arch/riscv/kvm/vcpu_pmu.c
@@ -556,6 +556,8 @@ void kvm_riscv_vcpu_pmu_init(struct kvm_vcpu *vcpu)
 	 */
 	if (!riscv_isa_extension_available(NULL, SSCOFPMF))
 		return;
+	/* reject sscofpmf */
+	return;
 
 	ret = riscv_pmu_get_hpm_info(&hpm_width, &num_hw_ctrs);
 	if (ret < 0 || !hpm_width || !num_hw_ctrs)
-- 
2.51.0

