From fbc87ee0fb3bdb811702004cbe3280d9c44249a5 Mon Sep 17 00:00:00 2001
From: chenzhanzhan <chenzhanzhan@eswincomputing.com>
Date: Mon, 19 May 2025 17:12:58 +0800
Subject: [PATCH 513/652] feature: Sync d560 dts config

Changelogs:
1. Sync d560 dts config

Signed-off-by: chenzhanzhan <chenzhanzhan@eswincomputing.com>
---
 .../boot/dts/eswin/eic7702-d560-interleave.dts   | 13 +++++++++++++
 .../dts/eswin/eic7702-som560-interleave.dtsi     | 16 ++++++++--------
 2 files changed, 21 insertions(+), 8 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-d560-interleave.dts b/arch/riscv/boot/dts/eswin/eic7702-d560-interleave.dts
index 4a1a51635a98..f60641e6664c 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-d560-interleave.dts
+++ b/arch/riscv/boot/dts/eswin/eic7702-d560-interleave.dts
@@ -39,6 +39,12 @@ gpio-111 {
 			linux,default-trigger = "heartbeat";
 		};
 	};
+	reg_vcc1v8: vcc1v8 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc1v8";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+	};
 };
 
 &d0_i2s1 {
@@ -75,6 +81,7 @@ &d1_sdio0 {
 	non-removable;
 	no-sd;
 	no-mmc;
+	vqmmc-supply = <&reg_vcc1v8>;
 	aw315:wifi_aw3155@0 {
 		compatible = "aml_w1_sdio";
 		reg = <0x0>;
@@ -86,6 +93,12 @@ aw315:wifi_aw3155@0 {
 		irq-gpios = <&d1_porta 18 GPIO_ACTIVE_HIGH>;
 		rst-gpios = <&d1_porta 16 GPIO_ACTIVE_HIGH>;
 	};
+	mdhd_wlan {
+		compatible = "android,bcmdhd_wlan";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_die1_gpio13_default>;
+		gpio_wl_reg_on = <&d1_porta 13 GPIO_ACTIVE_HIGH>;
+	};
 };
 
 &d0_usbdrd3_1 {
diff --git a/arch/riscv/boot/dts/eswin/eic7702-som560-interleave.dtsi b/arch/riscv/boot/dts/eswin/eic7702-som560-interleave.dtsi
index 41ea1b44401b..7e65b902c779 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-som560-interleave.dtsi
+++ b/arch/riscv/boot/dts/eswin/eic7702-som560-interleave.dtsi
@@ -959,8 +959,8 @@ &d0_gmac0 {
 	rst-gpios = <&porta 29 GPIO_ACTIVE_LOW>;
 	eswin,rgmiisel = <&pinctrl 0x290 0x3>;
 	eswin,led-cfgs = <0x6100 0xa40 0x420>;
-	dly-param-1000m = <0x23232323 0x5a0c6423 0x0c0c0c0c>;
-	dly-param-100m = <0x50505050 0x803f8050 0x3f3f3f3f>;
+	dly-param-1000m = <0x20202020 0x96206420 0x20202020>;
+	dly-param-100m = <0x20202020 0x96205A20 0x20202020>;
 	dly-param-10m = <0 0 0>;
 	status = "okay";
 };
@@ -971,8 +971,8 @@ &d1_gmac0 {
 	rst-gpios = <&d1_porta 29 GPIO_ACTIVE_LOW>;
 	eswin,rgmiisel = <&d1_pinctrl 0x290 0x3>;
 	eswin,led-cfgs = <0x6100 0xa40 0x420>;
-	dly-param-1000m = <0x23232323 0x5a0c6423 0x0c0c0c0c>;
-	dly-param-100m = <0x50505050 0x803f8050 0x3f3f3f3f>;
+	dly-param-1000m = <0x20202020 0x8C205A20 0x20202020>;
+	dly-param-100m = <0x20202020 0x96205A20 0x20202020>;
 	dly-param-10m = <0 0 0>;
 	status = "okay";
 };
@@ -983,8 +983,8 @@ &d0_gmac1 {
 	rst-gpios = <&porta 34 GPIO_ACTIVE_LOW>;
 	eswin,rgmiisel = <&pinctrl 0x294 0x3>;
 	eswin,led-cfgs = <0x6100 0xa40 0x420>;
-	dly-param-1000m = <0x25252525 0x5a266425 0x26262626>;
-	dly-param-100m = <0x48484848 0x80588048 0x58585858>;
+	dly-param-1000m = <0x20202020 0x46205020 0x20202020>;
+	dly-param-100m = <0x20202020 0x50205020 0x20202020>;
 	dly-param-10m = <0 0 0>;
 	status = "okay";
 };
@@ -995,8 +995,8 @@ &d1_gmac1 {
 	rst-gpios = <&d1_porta 34 GPIO_ACTIVE_LOW>;
 	eswin,rgmiisel = <&d1_pinctrl 0x294 0x3>;
 	eswin,led-cfgs = <0x6100 0xa40 0x420>;
-	dly-param-1000m = <0x25252525 0x5a266425 0x26262626>;
-	dly-param-100m = <0x48484848 0x80588048 0x58585858>;
+	dly-param-1000m = <0x20202020 0x46205A20 0x20202020>;
+	dly-param-100m = <0x20202020 0x50205A20 0x20202020>;
 	dly-param-10m = <0 0 0>;
 	status = "okay";
 };
-- 
