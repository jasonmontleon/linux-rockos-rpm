+
+#ifndef __OTP_EIC770X_H__
+#define __OTP_EIC770X_H__
+
+#include <asm/types.h>
+#include "otp_map_eic770x.h"
+
+#define ERR_OK 0
+#define ERR_OTP  -1
+#define ERR_OTP_LEN (ERR_OTP + 2)
+
+#define DEV_MODE     0x00
+#define DEV_MODE_BIT 0x01
+
+typedef struct {
+	u8 en_hevc_encode : 1;
+	u8 en_hevc_decode : 1;
+	u8 en_avc_encode  : 1;
+	u8 en_avc_decode  : 1;
+	u8 reserved0      : 4;
+
