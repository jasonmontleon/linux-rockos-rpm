From 36ac10c509085a6aa758ceb0eb7f41ea9e3d552f Mon Sep 17 00:00:00 2001
From: luoshanggui <luoshanggui@eswincomputing.com>
Date: Thu, 27 Feb 2025 09:03:07 +0800
Subject: [PATCH 461/652] feat : add e31 event op Changelogs:

Signed-off-by: luoshanggui <luoshanggui@eswincomputing.com>
---
 .../soc/eswin/ai_driver/common/devices/npu_base_regs.h |  2 ++
 drivers/soc/eswin/ai_driver/common/dla_interface.h     |  2 ++
 drivers/soc/eswin/ai_driver/common/hetero_common.h     |  1 +
 drivers/soc/eswin/ai_driver/npu/parse_dep.c            | 10 +++++++++-
 4 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/eswin/ai_driver/common/devices/npu_base_regs.h b/drivers/soc/eswin/ai_driver/common/devices/npu_base_regs.h
index bfbbe244a7127..b082c38f05185 100644
--- a/drivers/soc/eswin/ai_driver/common/devices/npu_base_regs.h
+++ b/drivers/soc/eswin/ai_driver/common/devices/npu_base_regs.h
@@ -87,8 +87,10 @@ typedef enum type_NPU_MODULE_SEL_ID_E {
 /* NPU system port base address */
 #if defined(DIE1) && DIE1
 #define NPU_SYS_BASE_ADDR 0x71C00000
+#define ANOTHER_NPU_CTL_ADDR (NPU_CTRL_BASE_ADDR - 0x20000000)
 #else
 #define NPU_SYS_BASE_ADDR 0x51C00000
+#define ANOTHER_NPU_CTL_ADDR (NPU_CTRL_BASE_ADDR + 0x20000000)
 #endif
 /* NPU configuration base address */
 #define NPU_CFG_BASE_ADDR 0x51828000
diff --git a/drivers/soc/eswin/ai_driver/common/dla_interface.h b/drivers/soc/eswin/ai_driver/common/dla_interface.h
index 550dd165b57d6..bd2d66b85d56f 100644
--- a/drivers/soc/eswin/ai_driver/common/dla_interface.h
+++ b/drivers/soc/eswin/ai_driver/common/dla_interface.h
@@ -73,6 +73,7 @@
 #define DLA_OP_SWITCH 0x11
 #define DLA_OP_MERGE 0x12
 
+#define E31 2
 /**
  * @name Memory types
  * @brief DLA engnine can read/write to/from 3 memory types
@@ -250,6 +251,7 @@ struct dla_common_op_desc {
 struct dla_event_op_desc {
     int16_t index;         // a unique event op index in loadable
     int8_t submodel_type;  // 0-umd; 1-kmd
+    int8_t peer_type;     //0-no ; 1: e31 -> e31
 } __attribute__((packed, aligned(ALIGNMENT)));
 
 #define EVENT_OP_TENSOR_NUM 8
diff --git a/drivers/soc/eswin/ai_driver/common/hetero_common.h b/drivers/soc/eswin/ai_driver/common/hetero_common.h
index 18297aae70022..74e134ea2e4a0 100644
--- a/drivers/soc/eswin/ai_driver/common/hetero_common.h
+++ b/drivers/soc/eswin/ai_driver/common/hetero_common.h
@@ -358,6 +358,7 @@ typedef struct _npu_dep_info {
     union {
         u64 lut_address;
         u64 dsp_eval_param;
+        u64 peer_type;
     };
 } __attribute__((aligned(CDMA_SRC_BYTE_ALIGN))) npu_dep_info_t;
 
diff --git a/drivers/soc/eswin/ai_driver/npu/parse_dep.c b/drivers/soc/eswin/ai_driver/npu/parse_dep.c
index acdbe89ac814d..5a09746e08dc6 100644
--- a/drivers/soc/eswin/ai_driver/npu/parse_dep.c
+++ b/drivers/soc/eswin/ai_driver/npu/parse_dep.c
@@ -226,6 +226,14 @@ static void dependency_consumer2producer(struct win_executor *executor,
 		if (pcer == IDX_EVENT_SOURCE)
 			dependency_count[i]++;
 
+		if((pcer == IDX_EVENT_SOURCE || pcer == IDX_EVENT_SINK) &&
+		    task->op_desc[i].event_op.submodel_type == E31)
+		{
+			npu_info->peer_type = E31;
+			dla_debug("e31 event op:%d,depcnt:%d,peer_type:%d\n", i,
+			           dependency_count[i], npu_info->peer_type);
+		}
+
 		for (j = IDX_SDP; j <= IDX_PDP; j++) {
 			consumer = task->common_desc[i].fused_parent.index;
 			event = task->common_desc[i].fused_parent.event;
@@ -274,7 +282,7 @@ static void dependency_consumer2producer(struct win_executor *executor,
 			 */
 		}
 		dependency_count[i]++;
-		dla_detail("i:%d dependency_count:%d\n", i,
+		dla_debug("i:%d dependency_count:%d\n", i,
 			   dependency_count[i]);
 		npu_info->depcnt = dependency_count[i];
 		pcer_cnt[pcer]++;
-- 
2.53.0

