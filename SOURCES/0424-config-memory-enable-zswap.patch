From: Han Gao <rabenda.cn@gmail.com>
Date: Thu, 6 Mar 2025 23:15:41 +0800
Subject: [PATCH 424/481] config: memory: enable zswap

Signed-off-by: Han Gao <rabenda.cn@gmail.com>
---
 arch/riscv/configs/win2030_defconfig | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/riscv/configs/win2030_defconfig b/arch/riscv/configs/win2030_defconfig
index ce7255a46970..b1223dff91aa 100644
--- a/arch/riscv/configs/win2030_defconfig
+++ b/arch/riscv/configs/win2030_defconfig
@@ -60,6 +60,13 @@ CONFIG_BLK_WBT=y
 CONFIG_BLK_CGROUP_IOCOST=y
 CONFIG_BLK_SED_OPAL=y
 CONFIG_BINFMT_MISC=m
+CONFIG_ZSWAP=y
+CONFIG_ZSWAP_ZPOOL_DEFAULT_ZSMALLOC=y
+CONFIG_ZBUD=y
+CONFIG_Z3FOLD_DEPRECATED=m
+CONFIG_SLAB_FREELIST_RANDOM=y
+CONFIG_SLAB_FREELIST_HARDENED=y
+# CONFIG_COMPAT_BRK is not set
 CONFIG_SPARSEMEM_MANUAL=y
 CONFIG_CMA=y
 CONFIG_NET=y
