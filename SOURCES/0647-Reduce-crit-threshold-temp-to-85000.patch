From e76bd8a96b451e4d242dd9b63d439f81ac0ddffe Mon Sep 17 00:00:00 2001
From: Jason Montleon <jmontleo@redhat.com>
Date: Tue, 18 Feb 2025 12:49:37 -0500
Subject: [PATCH 647/652] Reduce crit threshold temp to 85000

---
 arch/riscv/boot/dts/eswin/eswin-win2030-die0-soc.dtsi | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/riscv/boot/dts/eswin/eswin-win2030-die0-soc.dtsi b/arch/riscv/boot/dts/eswin/eswin-win2030-die0-soc.dtsi
index ddc23330610a..981ef91ef58f 100644
--- a/arch/riscv/boot/dts/eswin/eswin-win2030-die0-soc.dtsi
+++ b/arch/riscv/boot/dts/eswin/eswin-win2030-die0-soc.dtsi
@@ -51,7 +51,7 @@ target: trip-point1 {
 					type = "passive";
 				};
 				crit: trip-point2 {
-					temperature     = <105000>;
+					temperature     = <85000>;
 					hysteresis      = <0>;
 					type            = "critical";
 				};
